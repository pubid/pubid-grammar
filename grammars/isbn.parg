# Port of lib/pubid/isbn/parser.rb: [ISBN[ |:]] digits/hyphens with an
# optional final X (ISBN-10 check digit), per ISO 2108.

grammar PubidIsbn version "0.1.0" edition 2 {
  digit = %x30-39
  x_digit = digit / "X"
  isbn_prefix = ["ISBN" (space / ([space] colon [space]))]
  digit_group = 1*digit
  hyphen_body = (1*digit *("-" 1*digit) ["-" (digit / "X")]) as body
  plain_body = (9*12digit [(digit / "X")]) as body
  identifier = [isbn_prefix] (hyphen_body / plain_body)
  space = " "
  colon = ":"
  hyphen = "-"
  entry identifier: identifier

  bindings identifier {
    body -> body (string)
  }


  test {
    accept "ISBN 978-0-306-40615-7"
    accept "978-0-306-40615-7"
    accept "0-306-40615-2"
    reject "nonsense"
  }
}
