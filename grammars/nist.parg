# Port of lib/pubid/nist/parser.rb — NIST/NBS identifiers: compound and
# simple series, report numbers (first/second number families), editions
# (e/r/rev/dash-year), dates (ISO, dash, month-year), revisions,
# versions, volumes, parts, updates, addenda, supplements, errata,
# drafts, stages (old "(1pd)" and new ".1pd"), circ supplements,
# dated NBS bulletins and the Research Library series. The gem's
# parse()-side preprocessing (Preprocessor + ALL_PARTS suffix +
# parsed_format tagging) is Tier-3 and outside the grammar. Source
# deviations, all lint-forced longest-first reorderings that preserve
# the accept-set under PEG backtracking: esp before es in language_code,
# romans ordered longest-first, CSM before CS in simple_series; the
# empty-alternative captures (:supplement_empty, addendum's str(""))
# become bracketed optionals.
#
# Edition-2 typed-bindings surface, (any)-free. The caster (lib/pubid/
# nist/caster.rb) dispatches on the edition-1 wrapper-capture keys, so
# every wrapper is RE-ADDED at its original site with its body inlined
# to raw terms. Only the two cross-engine-stable scalar/wrapper
# vocabularies are used (the asme/bsi/itu conversions):
# - (string) over pure-raw content: the capture body is inlined so it
#   lowers to one scalar span (a capture wrapping a rule ref would
#   materialize element hashes, which cannot bind (string)).
# - (raw) over composite content: the raw pass-through delivers the
#   inner-capture Hash exactly as the Parslet tree did, both engines
#   keeping node form inside raw wrappers; the caster reads the leaves
#   with to_s. The caster consumes every raw interior with to_s.
# - POLYMORPHIC captures split per branch under two names, asme's
#   designator/designator_code pattern: first_number (string) on the
#   bare branches and first_number_composite (raw) on the branches
#   carrying inner captures (second_number/second_number_composite
#   alike). The PEG alternation order is untouched — only the capture
#   name per branch changes. The caster maps the composite keys back
#   onto the first_number/second_number dispatch.
# - revision_letter keeps its capture name at both sites (the bare
#   letter inside base_portion, the composite inside
#   second_number_composite) but is deliberately UNBOUND: both
#   occurrences ride inside (raw) interiors, and no caster branch
#   dispatches on it.
# - addendum captures its marker (addendum_marker) so the (raw)
#   wrapper ALWAYS holds a hash: with the number optional absent the
#   marker-less wrapper would lower to a bare span, whose top-level
#   (raw) passthrough diverges per engine (span node vs plain string).
#   A capture over the optional itself is likewise forbidden (#394:
#   wasm emits "" when absent) — the optional wraps the capture.
# Bare rule refs adjacent to a capture are parenthesized so the capture
# cannot drop. supplement_empty stays deleted: zero-width marker, the
# bare "NBS.CIRC.sup" form routes on circ_series.

grammar PubidNist version "0.1.0" edition 2 {
  digit = %x30-39
# kept for rule-name stability; captures inline the class directly
  upper_letter = %x41-5A
  lower_letter = %x61-7A
  letter = upper_letter / lower_letter
  word_char = letter / %x30-39 / "_"
  any_char = %x01-10FFFF
  digits = 1*%x30-39
  space = " "
  dot = "."
  dash = "-"
  slash = "/"
  hash_prefix = "#"

  month_abbrev = "January" / "February" / "September" / "November" / "December" / "October" / "August" / "June" / "March" / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec"

  # esp before es: lint-forced longest-first (see header).
  language_code = {
    ( [(space / dot)]
      ( ( "esp" / "es" / "pt" / "chi" / "viet" / "port"
        / (2*4%x61-7A) ) as translation )
    )
  }
  stage_id = "i" / "I" / "f" / "F" / "1" / "2" / "3" / "4" / "5" / "6" / "7" / "8" / "9"
  stage_type = "pd" / "PD" / "wd" / "WD" / "prd" / "PRD"
  old_stage = {
    ( "("
      ( ( "i" / "I" / "f" / "F" / "1" / "2" / "3" / "4" / "5" / "6" / "7"
          / "8" / "9" ) as stage_id
        ( "pd" / "PD" / "wd" / "WD" / "prd" / "PRD" ) as stage_type )
      as stage
      ")" )
  }
  new_stage = {
    ( (space / dot)
      ( ( "i" / "I" / "f" / "F" / "1" / "2" / "3" / "4" / "5" / "6" / "7"
          / "8" / "9" ) as stage_id
        ( "pd" / "PD" / "wd" / "WD" / "prd" / "PRD" ) as stage_type )
      as stage )
  }
  publisher = ("NBS" / "NIST") as publisher

  # CSM before CS, NSRDS-NBS before NSRDS: lint-forced longest-first.
  compound_series = {
    (
      "NBS BRPD-CRPL-D" / "NBS CRPL-F-A" / "NBS CRPL-F-B" / "NBS CS-E"
      / "CSRC Building Block" / "CSRC Use Case" / "CSRC Book"
      / "ITL Bulletin" / "NSRDS-NBS" / "NIST LCIRC" / "NBS LCIRC"
      / "NIST.LCIRC" / "NBS.LCIRC" / "NBS RPT" / "NIST PS" / "NIST DCI"
      / "NIST Other" / "NISTPUB" / "NBS CSM" / "NBS CIRC" / "NBS.CRPL"
      / "NBS CRPL" / "NBS CS" / "NBS CIS" / "NBS HR" / "NBS IRPL"
      / "NBS IP" / "NBS PS" / "NBS BH"
    ) as series
  }
  simple_series = {
    (
      "NCSTAR" / "CHIPS" / "NWIRP" / "CSWP" / "JPCRD" / "JRES" / "OWMWP"
      / "SIBS" / "TIBM" / "FIPS" / "MONO" / "AMS" / "VTS" / "BSS" / "BMS"
      / "GCR" / "CSM" / "CRPL" / "CIRC" / "TTB" / "EAB" / "HB" / "MP"
      / "NSRDS" / "RPT" / "LCIRC" / "AI" / "CS" / "IR" / "SP" / "TN"
      / "PC" / "BH" / "RB"
    ) as series
  }

  # VIII before VII before VI before III before II: longest-first.
  roman = "VIII" / "VII" / "VI" / "III" / "II" / "IX" / "IV" / "X" / "V" / "I"

  number_suffix = {
    (
      ( "U" lower_letter )
      / (
        ( !("r" %x30-39) letter !(upper_letter)
          !("ec" / "ndex" / "ndx" / "nsert" / "rrata" / "raft" / "pp"
            / "s" / "t" / "hi" / "iet" / "ort" / "r" / "p") )
        [digits]
      )
    )
  }
  digits_with_suffix = (digits [(number_suffix !%x30-39)])

  # Alternative order is semantic (PEG): the guarded forms precede the
  # bare digits tail; the (SP/PT/ES) forms carry lookaheads that keep
  # the accept-set equal to the edition-1 grammar. Wrapper captures
  # restored at their edition-1 sites (first_number outer + the
  # owmwp_date_number / number_with_volume / number_with_rev_year /
  # number_with_letter_revision composites). The polymorphic wrapper is
  # split per branch — first_number_composite (raw) on the branches
  # carrying inner captures, first_number (string) on the bare ones —
  # with the alternation order untouched.
  first_number = {
      (
        (
          ( ( (2%x30-39) as owmwp_month "-" (2%x30-39) as owmwp_day "-"
              (4%x30-39) as owmwp_year ) as owmwp_date_number
          ) as first_number_composite
        )
        / ( "ADHOC" ) as first_number
        / ( "div" 1*%x30-39 ) as first_number
        / (
            ( "January" / "February" / "September" / "November" / "December"
            / "October" / "August" / "June" / "March" / "April" / "July"
            / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
            / "Sep" / "Oct" / "Nov" / "Dec" )
            "-"
            ( "January" / "February" / "September" / "November" / "December"
            / "October" / "August" / "June" / "March" / "April" / "July"
            / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
            / "Sep" / "Oct" / "Nov" / "Dec" )
            1*%x30-39
          ) as first_number
        / (
            ( ( ( (1*%x30-39) as number ( "v" (1*%x30-39) as volume_suffix ) )
                as number_with_volume ) as first_number_composite )
          )
        / ( 1*%x30-39 "-"
            ( "VIII" / "VII" / "VI" / "III" / "II" / "IX" / "IV" / "X" / "V"
              / "I" )
            "-" 1*%x30-39 [( "." 1*%x30-39 )] ) as first_number
        / ( 1*%x30-39 "GB" "-" 1*%x30-39 [%x41-5A] ) as first_number
        / ( 1*%x30-39 %x41-5A "-" 1*%x30-39 ) as first_number
        / (
            ( ( "v" (1*%x30-39) as volume_number )
              ( "n" (1*%x30-39) as issue_number ) ) as first_number_composite
          )
        / ( 1*%x30-39 "supprev" ) as first_number
        / ( 1*%x30-39 "e" 1*%x30-39 "rev" 1*%x30-39 ) as first_number
        / (
            ( ( ( (1*%x30-39) as number ( "rv" (1*%x30-39) as revision_year ) )
                as number_with_rev_year ) as first_number_composite )
          )
        / ( 1*%x30-39 "e" 1*%x30-39 "rev"
            ( "January" / "February" / "September" / "November" / "December"
            / "October" / "August" / "June" / "March" / "April" / "July"
            / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
            / "Sep" / "Oct" / "Nov" / "Dec" )
            1*%x30-39 ) as first_number
        / ( 1*%x30-39 "e" 1*%x30-39 "supp" [1*%x30-39] ) as first_number
        / ( "e" 1*%x30-39 "rev"
            ( "January" / "February" / "September" / "November" / "December"
            / "October" / "August" / "June" / "March" / "April" / "July"
            / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
            / "Sep" / "Oct" / "Nov" / "Dec" )
            1*%x30-39 ) as first_number
        / ( "e" 1*%x30-39 "supp" [1*%x30-39] ) as first_number
        / ( 1*%x30-39 "e" 1*%x30-39 ) as first_number
        / ( "e" 1*%x30-39 !("-" 1*%x30-39) ) as first_number
        / ( %x61-7A 1*%x30-39 ) as first_number
        / ( 1*%x30-39 "supp"
            ( "January" / "February" / "September" / "November" / "December"
            / "October" / "August" / "June" / "March" / "April" / "July"
            / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
            / "Sep" / "Oct" / "Nov" / "Dec" )
            1*%x30-39 ) as first_number
        / ( 1*%x30-39 "supp" [1*%x30-39] ) as first_number
        / ( 1*%x30-39 "sup"
            ( "January" / "February" / "September" / "November" / "December"
            / "October" / "August" / "June" / "March" / "April" / "July"
            / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
            / "Sep" / "Oct" / "Nov" / "Dec" )
            1*%x30-39 ) as first_number
        / ( 1*%x30-39 "sup" ) as first_number
        / (
            ( ( (1*%x30-39) as number
                ( ("sp" / "pt" / "es" / "SP" / "PT" / "ES") as language_code )
                ( !%x41-5A !%x30-39 !(%x41-5A / %x61-7A) !("-") !(".") ) )
              as first_number_composite )
          )
        / (
            ( ( (1*%x30-39) as number
                ( "pt" (1*%x30-39) as part_number )
                ( "e" (1*%x30-39) as edition_year ) )
              as first_number_composite )
          )
        / (
            ( ( (1*%x30-39) as number
                ( "(" ( ("SP" / "PT" / "ES") as language_code ) ")" ) )
              as first_number_composite )
          )
        / (
            ( ( ( (1*%x30-39) as number
                  ( %x41-5A ) as letter_suffix
                  ( "r" (1*%x30-39) as revision_id ) )
                as number_with_letter_revision ) as first_number_composite )
          )
        / (
            ( 1*%x30-39
              [ (
                  ( ( "U" %x61-7A )
                    / (
                      ( !("r" %x30-39) (%x41-5A / %x61-7A) !(%x41-5A)
                        !("ec" / "ndex" / "ndx" / "nsert" / "rrata" / "raft"
                          / "pp" / "s" / "t" / "hi" / "iet" / "ort" / "r"
                          / "p") )
                      [1*%x30-39]
                    ) )
                  !%x30-39
                ) ]
            ) as first_number
          )
      )
  }

  # The polymorphic wrapper is split per branch —
  # second_number_composite (raw) on the branches carrying inner
  # captures (revision_letter, number_only+edition_id, revision_simple),
  # second_number (string) on the bare ones — with the alternation
  # order untouched.
  second_number = {
      (
          ( ( !( "January" / "February" / "September" / "November" / "December"
               / "October" / "August" / "June" / "March" / "April" / "July"
               / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
               / "Sep" / "Oct" / "Nov" / "Dec" )
            !("draft")
            ( ( ( (1*%x30-39) as number_only "r"
                  ( %x41-5A / %x61-7A ) as letter )
                as revision_letter ) ) )
            as second_number_composite )
        / ( 1*%x30-39 ( ("supp" / "sup") )
            ( !%x30-39 !(%x41-5A / %x61-7A) ) ) as second_number
        / ( 1*%x30-39 ("r") 1*%x30-39 ( "U" %x61-7A ) ) as second_number
        / ( 1*%x30-39 ("r") 1*%x30-39 (%x41-5A / %x61-7A) ) as second_number
        / (
            ( ( (1*%x30-39) as number_only
                ( "r" ( (1*%x30-39 ["." 1*%x30-39]) as edition_id ) ) )
              as second_number_composite )
          )
        / ( 1*%x30-39 ("_") 1*%x30-39 "-" 1*%x30-39 [%x41-5A] ) as second_number
        / ( %x61-7A "-" 1*%x30-39 ) as second_number
        / ( 1*%x30-39 ("pt") 1*%x30-39 !("-") ) as second_number
        / ( 1*%x30-39 %x41-5A ) as second_number
        / (
            ( ( ( ( (1*%x30-39) as number_only ) ("r")
                  (%x41-5A / %x61-7A) )
                as revision_letter ) as second_number_composite )
          )
        / ( "r" (%x41-5A / %x61-7A) ) as revision_letter_suffix
        / (
            ( ( ( "r" ( (1*%x30-39 ["." 1*%x30-39]) as edition_id ) )
                as revision_simple ) as second_number_composite )
          )
        / ( "NCNR" ) as second_number
        / ( "PERMIS" ) as second_number
        / ( "BFRL" ) as second_number
        / ( 1*3%x41-5A !(%x61-7A) ) as second_number
        / (
            ( ( 1*%x30-39
                [ (
                    ( ( "U" %x61-7A )
                      / (
                        ( !("r" %x30-39) (%x41-5A / %x61-7A) !(%x41-5A)
                          !("ec" / "ndex" / "ndx" / "nsert" / "rrata"
                            / "raft" / "pp" / "s" / "t" / "hi" / "iet"
                            / "ort" / "r" / "p") )
                        [1*%x30-39]
                      ) )
                    !%x30-39
                  ) ]
                ( !("-"
                    ( "January" / "February" / "September" / "November"
                    / "December" / "October" / "August" / "June" / "March"
                    / "April" / "July" / "May" / "Jan" / "Feb" / "Mar"
                    / "Apr" / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov"
                    / "Dec" )
                    1*%x30-39 "/" ) ) )
            / ( %x61-7A !%x30-39 ) )
          ) as second_number
      )
  }

  # Wrapper captures restored per alternative, as in edition 1.
  edition = {
      ( [ [ " " ] ]
        ( "e" ( (1*%x30-39 ["." 1*%x30-39]) as edition_id ) ) as edition_e )
    / (
        ( ( " " ) ( "r" ( (1*%x30-39 ["." 1*%x30-39]) as edition_id )
          ( %x41-5A / %x61-7A ) as edition_letter )
          as edition_r_with_space_letter )
      )
    / (
        ( ( " " ) ( "r" ( (1*%x30-39 ["." 1*%x30-39]) as edition_id ) )
          as edition_r_with_space )
      )
    / (
        ( "r" ( (1*%x30-39 ["." 1*%x30-39]) as edition_id )
          ( %x41-5A / %x61-7A ) as edition_letter )
        as edition_r_no_space_letter
      )
    / (
        ( "r" ( (1*%x30-39 ["." 1*%x30-39]) as edition_id ) )
        as edition_r_no_space
      )
    / ( ( [" "] "rev" [" "] ( (1*%x30-39) as edition_id ) )
        as edition_rev )
    / ( "-" ( ( (%x31-39) as edition_id ) !%x30-39 )
        as edition_historical )
    / ( "-" ( (4%x30-39) as dash_year ) as edition_dash_year )
  }

  date = {
      (
        ( ( ( "-" ) (4%x30-39) as date_year (2%x30-39) as date_month
            (2%x30-39) as date_day )
          / ( ( "-" ) (4%x30-39) as date_year (2%x30-39) as date_month )
          / ( ( "-" ) (4%x30-39) as date_year )
          / ( ( "-" )
              ( ( "January" / "February" / "September" / "November"
                / "December" / "October" / "August" / "June" / "March"
                / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
                / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
                as date_month )
              ( (1*%x30-39) as date_year ) )
        ) as date
      )
  }
  iso_date = {
    ( (4%x30-39) as date_year "-" (2%x30-39) as date_month "-"
      (2%x30-39) as date_day )
  }
  dated_identifier = {
    [hash_prefix] (publisher) (space / dot)
    ( ( (4%x30-39) as date_year "-" (2%x30-39) as date_month "-"
        (2%x30-39) as date_day ) as dated_date )
    (space / dot)
    ( (1*%x30-39) as dated_seq )
  }
  research_library_identifier = {
    ( (publisher) (space) ( ( "Research Library" ) as series )
      [ (space) ( "(" (4%x30-39) as year ")" ) ] )
  }
  legacy_edition = {
      ( ( "r" / " R" ) ( (1*2%x30-39) as edition )
        ( %x61-7A ) as edition_letter )
    / ( "rev" [" "] (1*%x30-39) ) as edition_year
    / (
        ( "e" / " E" )
        ( (1*3%x30-39) as edition )
        ( "rev" ( (3*9(%x41-5A / %x61-7A)) as edition_month )
          ( (1*%x30-39) as edition_year ) )
      )
    / ( "e" (4%x30-39) as edition_year [(2%x30-39) as edition_month] )
  }
  crpl_range = {
    ( (1*%x30-39) ("_") (1*%x30-39) "-" (1*%x30-39) [%x41-5A] )
      as crpl_range
  }

  report_number = {
    first_number
    [
        ( "_" (1*%x30-39) ) as edition_year
      / ( "-" ( ( "January" / "February" / "September" / "November"
                / "December" / "October" / "August" / "June" / "March"
                / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
                / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
                as edition_month )
          (1*%x30-39) as edition_year )
      / ( "-" ( (1*%x30-39) as fips_part ) "-"
          ( ( "January" / "February" / "September" / "November" / "December"
            / "October" / "August" / "June" / "March" / "April" / "July"
            / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
            / "Sep" / "Oct" / "Nov" / "Dec" )
            as edition_month )
          ( (1*%x30-39) as edition_day ) "/"
          ( (1*%x30-39) as edition_year ) )
      / (
          ( ( "-" ( (1*%x30-39) as decimal_base )
              ( "." ( (1*%x30-39) as decimal_suffix ) ) )
            as decimal_number )
        )
      / (
          ( ( "-" ( (1*%x30-39) as letter_base )
              ( ( "U" ( %x61-7A ) as letter_suffix_extra )
                / ( ( %x41-5A ) as letter_suffix ) ) )
            as letter_number )
        )
      / (
          ( ( "-" ( (1*%x30-39) as letter_base ) "-"
              !( "January" / "February" / "September" / "November"
               / "December" / "October" / "August" / "June" / "March"
               / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
               / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
              ( ( %x41-5A ) as letter_suffix )
              ( !((%x41-5A / %x61-7A) / %x30-39) ) )
            as letter_number )
        )
      / (
          ( ( "-" ( (4%x30-39) as dash_year )
              ( !(" ") !"." !part !crpl_range !second_number !"-" ) )
            as edition_dash_year )
        )
      / (
          ( ( "-" (second_number) "-" ( (4%x30-39) as dash_year )
              ( !(" ") !"." !part !crpl_range !second_number !revision
                !draft ) )
            as second_number_edition_year )
        )
      / (
          ( ( "-" (second_number) "-"
              ( ( "January" / "February" / "September" / "November"
                / "December" / "October" / "August" / "June" / "March"
                / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
                / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
                as edition_month )
              ( (1*%x30-39) as edition_year )
              ( !(" ") !"." !part !crpl_range !edition !revision !draft ) )
            as fips_month_year_after_part )
        )
      / ( "-" (second_number) "-"
          ( ( ( (1*%x30-39) [%x41-5A] ) as part_number ) ) )
      / ( "." (second_number) )
      / ( "-" ( ( crpl_range / second_number ) ) [edition] )
      / ( "-" (edition) )
    ]
  }
  volume = {
    [ [space] ] ( ( "Vol. " / "Vol." / "v" ) )
    ( ( (1*%x30-39)
        [ ( ( "a-l" / "m-z" / "A-L" / "M-Z" ) ) ]
        (0*2%x41-5A) ) as volume )
  }
  part = {
    ( ( " Part. " / " Part." / " Part " )
      / ( [space] ( "pt" / "p" / "P" ) ) )
    (
      ( ( (1*%x30-39)
          [ ( [" "] ("r") (1*%x30-39) ) ]
          [ ( "add" [ ( "e" (1*%x30-39) ) ] ) ]
          [ "-" (1*%x30-39) ] ) as part )
    )
  }
  revision = {
      ( [space] ( "r" / "rev" ) [space]
        ( ( "January" / "February" / "September" / "November" / "December"
          / "October" / "August" / "June" / "March" / "April" / "July"
          / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
          / "Sep" / "Oct" / "Nov" / "Dec" ) as revision_month )
        ( (1*%x30-39) as revision_year ) )
    / ( [space] ( "r" / "rev" ) ( (1*%x30-39) as revision ) (slash)
        ( (1*%x30-39) as revision_year ) )
    / ( " r" / "r" ) [space] ( (4%x30-39) as revision_year )
    / ( "rev" [space] ( (1*%x30-39) as revision_year ) )
    / (
        ( ( ( " rev " / "rev" / " r" / "r" / " Rev. " / " Rev."
              / " Revision (r)" ) as revision_prefix
            [" "]
            ( ( ( (1*%x30-39) [ (%x41-5A / %x61-7A) ] )
              / (1*(%x41-5A / %x61-7A)) ) as revision_id ) )
          as revision )
      )
    / ( " r" !%x01-10FFFF ) as revision_standalone
  }
  version = {
      ( [(space / dot)] ( "ver" ) [space]
        ( ( (1*%x30-39) *( "." (1*%x30-39) ) ) as version ) )
    / ( ( " Ver. " / " Version " )
        ( ( (1*%x30-39) (".") (1*%x30-39)
            [( "." (1*%x30-39) )] ) as version ) )
    / ( [(dash / space)] ( "v" )
        ( ( (1*%x30-39) (".") (1*%x30-39)
            [( "." (1*%x30-39) )] ) as version ) )
  }
  update = {
    ( ( ( "/Upd" ) / ( [ [" "] ] ( ( "/upd" / "-upd" ) ) ) )
      as update_prefix )
    (
      ( [ ( (1*%x30-39) as update_number ) ]
        [ "-"
          ( ( ( (4%x30-39) as update_year (2%x30-39) as update_month )
            / ( (4*%x30-39) as update_year ) ) ) ]
      ) as update
    )
  }
  addendum = {
    ( ( ( ( "-add" / ".add" / " Add." ) ) as addendum_marker )
      [( " " / "-" )]
      ( [ ( (1*%x30-39) ) as addendum_number ] )
    ) as addendum
  }
  supplement = {
    [ [space] ] [dot]
    ( ( "Suppl" / "Supp" / "Sup" / "supp" / "sup" ) )
    [
        ( ( "rev" ) as supplement_with_rev )
      / (
          ( ( ( "January" / "February" / "September" / "November"
              / "December" / "October" / "August" / "June" / "March"
              / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
              / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
              as supp_month_start
              ( (1*%x30-39) as supp_year_start ) "-"
              ( "January" / "February" / "September" / "November"
              / "December" / "October" / "August" / "June" / "March"
              / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
              / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
              as supp_month_end
              ( (1*%x30-39) as supp_year_end ) )
            as supplement_date_range )
        )
      / (
          ( ( ( "January" / "February" / "September" / "November"
              / "December" / "October" / "August" / "June" / "March"
              / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
              / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
              as supp_month ( (1*%x30-39) as supp_year ) )
            as supplement_date )
        )
      / (
          ( ( ( (1*%x30-39) as supp_number ) "/"
              ( (1*%x30-39) as supp_year ) )
            as supplement_slash_year )
        )
      / ( (1*%x30-39) as supp_year )
      / ( (1*(%x41-5A / %x61-7A / %x30-39 / "_")) as supplement_suffix )
    ]
  }
  errata = ( ( ["-"] ( ( "errata" / "err" ) ) ) ) as errata
  index = ("index" / "indx") as index
  insert = ("insert" / "ins") as insert
  appendix = ("app") as appendix
  section = ( "sec" [ (1*%x30-39) as section ] )
  dot_word = dot 3*word_char
  translation = {
      ( "(" ( 3*(%x41-5A / %x61-7A / %x30-39 / "_") ) as translation ")" )
    / ( (space) ( 3*(%x41-5A / %x61-7A / %x30-39 / "_") ) as translation )
    / ( [space] ( "." ) as translation
        ( 3*(%x41-5A / %x61-7A / %x30-39 / "_") ) as translation )
  }
  pd_suffix = ( ( " " ) (1*%x30-39) ( "pd" ) ) as public_draft
  draft = {
      ( ( ( " " ) ( "(Draft)" ) )
        / (
            [ [" "] ] ( ( "-" ) ( "draft" ) )
            [ ( ( ( " " ) (1*%x30-39) ) / (1*%x30-39) ) ]
          )
        / ( ( " " ) (1*%x30-39) ( "pd" ) )
      ) as draft
  }
  fips_date = {
    ( (dash) ( (1*%x30-39) as fips_part ) (dash)
      ( ( "January" / "February" / "September" / "November" / "December"
        / "October" / "August" / "June" / "March" / "April" / "July"
        / "May" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug"
        / "Sep" / "Oct" / "Nov" / "Dec" ) as fips_month )
      ( (1*%x30-39) as fips_day ) (slash)
      ( (1*%x30-39) as fips_year ) )
  }

  parts = {
      new_stage
    / ( ( "n" %x41-5A ) ) as n_letter_part
    / ( section )
    / ( index )
    / ( insert )
    / ( appendix )
    / ( pd_suffix )
    / ( edition )
    / ( date )
    / ( legacy_edition )
    / revision
    / ( version )
    / ( volume )
    / ( part )
    / ( update )
    / ( addendum )
    / ( supplement )
    / ( errata )
    / ( language_code )
  }

  mr_identifier = {
    [hash_prefix] (publisher) (dot) (simple_series)
    [dot]
    [report_number]
    [ ( "_" (1*%x30-39) ) as edition_year ]
    [ ( !("Suppl" / "Supp" / "Sup") upper_letter ) ]
    [edition]
    [update]
    ( 0*3( dot ( (digits) / ( !("Suppl" / "Supp" / "Sup") upper_letter ) ) ) )
    (*parts)
    [draft]
  }
  identifier = {
      circ_supplement_identifier
    / dated_identifier
    / mr_identifier
    / research_library_identifier
    / (
        (compound_series) (space / dot)
        [old_stage] [report_number] [fips_date]
        (*parts) [draft] [translation] [new_stage]
      )
    / (
        (publisher) (space / dot)
        (simple_series) [old_stage] (space / dot)
        [report_number] [fips_date]
        (*parts) [draft] [translation] [new_stage]
      )
    / (
        (simple_series) [old_stage] (space / dot)
        [report_number] [fips_date]
        (*parts) [draft] [translation] [new_stage]
      )
  }

  circ_supplement_identifier = {
    ( ( ( "NBS CIRC" / "NBS LCIRC" / "NBS.CIRC" / "NBS.LCIRC" )
        as series )
      ( ( " " / "." ) ) ) as circ_series
    (
        ( "supp"
          ( ( ( "January" / "February" / "September" / "November"
                / "December" / "October" / "August" / "June" / "March"
                / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
                / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
              as supp_month_start
              ( (1*%x30-39) as supp_year_start ) "-"
              ( "January" / "February" / "September" / "November"
              / "December" / "October" / "August" / "June" / "March"
              / "April" / "July" / "May" / "Jan" / "Feb" / "Mar" / "Apr"
              / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec" )
              as supp_month_end
              ( (1*%x30-39) as supp_year_end ) )
            as supplement_date_range ) )
      / ( ( "supp" / "sup" )
          ( ( (4%x30-39) as supp_year_start "-"
              (4%x30-39) as supp_year_end )
            as supplement_date_range ) )
      / ( ( "supp" / "sup" )
          [ ( ( ( "January" / "February" / "September" / "November"
                  / "December" / "October" / "August" / "June" / "March"
                  / "April" / "July" / "May" / "Jan" / "Feb" / "Mar"
                  / "Apr" / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov"
                  / "Dec" )
                (1*%x30-39) ) as supplement_month_year )
            / ( ( ( (1*%x30-39) as supp_number ) "/"
                  ( (1*%x30-39) as supp_year ) )
                as supplement_slash_year ) ] )
      / (
          ( ( ( (1*%x30-39) as base_number )
                ( "e" ( (1*%x30-39) as edition_number ) )
            / ( ( (1*%x30-39) as base_number )
                ( %x61-7A ) as revision_letter
                ( (1*%x30-39) as revision_number ) )
            / ( ( (1*%x30-39) as base_number )
                ( %x41-5A ) as letter_suffix )
            / ( (1*%x30-39) as simple_number ) )
            as base_portion )
          (
            ( ( "supp" / "sup" )
              [ ( ( ( "January" / "February" / "September" / "November"
                      / "December" / "October" / "August" / "June" / "March"
                      / "April" / "July" / "May" / "Jan" / "Feb" / "Mar"
                      / "Apr" / "Jun" / "Jul" / "Aug" / "Sep" / "Oct"
                      / "Nov" / "Dec" )
                    (1*%x30-39) ) as supplement_month_year )
                / ( ( "-" ( (1*%x30-39) as supp_number ) "/"
                      ( (1*%x30-39) as supp_year ) )
                    as supplement_dash_slash_year )
                / ( ( "-" (1*%x30-39) ) as supplement_year )
                / ( ( ( (1*%x30-39) as supp_number ) "/"
                      ( (1*%x30-39) as supp_year ) )
                    as supplement_slash_year ) ] )
            / ( ( "/" ) ( (1*%x30-39) as implicit_supplement_year ) )
                as implicit_supplement )
          )
        )
  }

  entry identifier: identifier

  bindings identifier {
    # Leaf captures — scalar strings.
    translation -> translation (string)
    stage_id -> stage_id (string)
    stage_type -> stage_type (string)
    publisher -> publisher (string)
    series -> series (string)
    owmwp_month -> owmwp_month (string)
    owmwp_day -> owmwp_day (string)
    owmwp_year -> owmwp_year (string)
    number -> number (string)
    volume_suffix -> volume_suffix (string)
    volume_number -> volume_number (string)
    issue_number -> issue_number (string)
    revision_year -> revision_year (string)
    letter_suffix -> letter_suffix (string)
    revision_id -> revision_id (string)
    language_code -> language_code (string)
    part_number -> part_number (string)
    edition_year -> edition_year (string)
    number_only -> number_only (string)
    letter -> letter (string)
    edition_id -> edition_id (string)
    revision_letter_suffix -> revision_letter_suffix (string)
    edition_letter -> edition_letter (string)
    date_year -> date_year (string)
    date_month -> date_month (string)
    date_day -> date_day (string)
    dated_seq -> dated_seq (string)
    year -> year (string)
    edition -> edition (string)
    edition_month -> edition_month (string)
    crpl_range -> crpl_range (string)
    fips_part -> fips_part (string)
    edition_day -> edition_day (string)
    decimal_base -> decimal_base (string)
    decimal_suffix -> decimal_suffix (string)
    letter_base -> letter_base (string)
    letter_suffix_extra -> letter_suffix_extra (string)
    dash_year -> dash_year (string)
    volume -> volume (string)
    part -> part (string)
    revision_month -> revision_month (string)
    revision_prefix -> revision_prefix (string)
    revision_standalone -> revision_standalone (string)
    version -> version (string)
    update_prefix -> update_prefix (string)
    update_number -> update_number (string)
    update_year -> update_year (string)
    update_month -> update_month (string)
    addendum_marker -> addendum_marker (string)
    addendum_number -> addendum_number (string)
    supplement_with_rev -> supplement_with_rev (string)
    supp_month_start -> supp_month_start (string)
    supp_year_start -> supp_year_start (string)
    supp_month_end -> supp_month_end (string)
    supp_year_end -> supp_year_end (string)
    supp_month -> supp_month (string)
    supp_year -> supp_year (string)
    supp_number -> supp_number (string)
    supplement_suffix -> supplement_suffix (string)
    section -> section (string)
    public_draft -> public_draft (string)
    draft -> draft (string)
    fips_day -> fips_day (string)
    fips_month -> fips_month (string)
    fips_year -> fips_year (string)
    base_number -> base_number (string)
    edition_number -> edition_number (string)
    revision_number -> revision_number (string)
    simple_number -> simple_number (string)
    supplement_month_year -> supplement_month_year (string)
    supplement_year -> supplement_year (string)
    implicit_supplement_year -> implicit_supplement_year (string)
    index -> index (string)
    insert -> insert (string)
    errata -> errata (string)
    appendix -> appendix (string)
    n_letter_part -> n_letter_part (string)

    # Composite wrapper captures (caster dispatch keys): their values
    # are the inner-capture hashes the caster's composite branches read,
    # so they bind with the cross-engine-stable (raw) pass-through — the
    # caster reads the interior leaves with to_s. The polymorphic
    # number wrappers split per branch: first_number/second_number
    # (string) over the bare branches, *_composite (raw) over the
    # branches carrying inner captures. revision_letter is deliberately
    # unbound: both its occurrences ride inside (raw) interiors.
    first_number -> first_number (string)
    first_number_composite -> first_number_composite (raw)
    second_number -> second_number (string)
    second_number_composite -> second_number_composite (raw)
    stage -> stage (raw)
    owmwp_date_number -> owmwp_date_number (raw)
    number_with_volume -> number_with_volume (raw)
    number_with_rev_year -> number_with_rev_year (raw)
    number_with_letter_revision -> number_with_letter_revision (raw)
    revision_simple -> revision_simple (raw)
    edition_e -> edition_e (raw)
    edition_r_with_space_letter -> edition_r_with_space_letter (raw)
    edition_r_with_space -> edition_r_with_space (raw)
    edition_r_no_space_letter -> edition_r_no_space_letter (raw)
    edition_r_no_space -> edition_r_no_space (raw)
    edition_rev -> edition_rev (raw)
    edition_historical -> edition_historical (raw)
    edition_dash_year -> edition_dash_year (raw)
    date -> date (raw)
    dated_date -> dated_date (raw)
    decimal_number -> decimal_number (raw)
    letter_number -> letter_number (raw)
    second_number_edition_year -> second_number_edition_year (raw)
    fips_month_year_after_part -> fips_month_year_after_part (raw)
    revision -> revision (raw)
    update -> update (raw)
    addendum -> addendum (raw)
    supplement_date_range -> supplement_date_range (raw)
    supplement_date -> supplement_date (raw)
    supplement_slash_year -> supplement_slash_year (raw)
    supplement_dash_slash_year -> supplement_dash_slash_year (raw)
    base_portion -> base_portion (raw)
    circ_series -> circ_series (raw)
    implicit_supplement -> implicit_supplement (raw)
  }

  test {
    accept "NIST SP 800-53"
    accept "NBS FIPS 140-2"
    accept "NIST HB 44"
    accept "NIST TN 1297"
    accept "NBS CIRC 25e"
    accept "NIST NCSTAR 1nA"
    accept "NBS HR 1-1nA"
    # (raw) wrapper + split-wrapper coverage: every composite branch
    # family rides a corpus case so the cross-engine gate replays it.
    accept "NIST CSWP 27 ipd"
    accept "NBS CIRC 467v1"
    accept "NIST IR 8278Ar1 ipd"
    accept "NIST SP 260-126rev2013"
    accept "NBS HB 44e2-1955"
    accept "NIST SP 800-63A-4"
    accept "NBS FIPS 100-1-1991"
    accept "NBS LCIRC 118supp3/1926"
    accept "NIST HB 135e2022/Upd1-202205"
    accept "NIST SP 800-38a-add"
    accept "NBS CIRC 101e2sup"
    accept "NBS LCIRC 145r11/1925"
    accept "NIST OWMWP 06-13e2018"
    accept "NIST SP 800-101 Rev. 1"
    accept "NIST SP 800-56A"
    accept "NIST SP 801-errata"
    accept "NIST SP 800-53 r5"
    accept "NIST SP 800-53r5A"
    accept "NIST SP 800-38A Add."
    accept "NIST.FIPS.197-upd"
    accept "NBS TN 467pt1 Add."
    reject "nonsense"
  }
}
