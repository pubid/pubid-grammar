# The EVS national identifier: the national prefix ("EVS" / "prEVS") over a
# CEN/CENELEC adoption, an ISO/IEC adoption, or a plain Estonian standard —
# plus the EVS-list supplements (national annex, corrigendum, AMD amendment)
# and the language code. The CEN spine is IMPORTED via `use` (TODO 11/C6
# imports): rules are namespaced cen_cenelec.* while captures keep their
# contract names.
#
# Edition 2: every reference inside a captured body is inlined to raw
# terms (a rule reference materializes as a named node in the edition-2
# tree, so only a raw capture binds a scalar span). The branch wrappers
# (adopted, intl, plain) and the supplement wrappers (evs_amd, evs_cor,
# na) keep the v1 tree shape and the bindings name the scalar leaves.

use cen_cenelec

grammar PubidEvs version "0.3.0" edition 2 {
  identifier = {
    [draft_prefix] "EVS" evs_separator
    (
      (cen_cenelec.identifier) as adopted
      / (evs_intl) as intl
      / (evs_plain) as plain
    )
    [evs_amd]
    [evs_cor / evs_ac]
    [evs_na]
  }

  draft_prefix = "pr" as draft_prefix
  evs_separator = ("-" / " ") as evs_separator

  # "EVS-ISO 9001:2015", "EVS-IEC 62368-1:2020" (+ their amendments)
  evs_intl = {
    (
      ((("ISO" / "IEC") as intl_org) " " (1*%x30-39) as number)
      [("-" (1*%x30-39) as part)]
      [(":" (4*4%x30-39) as year)]
    )
  }
  # "EVS 921:2019", "EVS-TS 1:2019", "EVS-TR 1:2019"
  evs_plain = {
    ([(("TS" / "TR") as evs_type) " "]) (1*%x30-39) as number [(":" (4*4%x30-39) as year)]
  }

  # " AMD1:2014" / "+AMD1" — the AMD amendment spelling; the separator is
  # semantic (list: "+A full standard plus the amendment", "/A only amendment")
  evs_amd = {
    (
      (("+" as supp_plus / "/" as supp_slash / " " as supp_space) ("AMD" as amd_kind))
      (1*%x30-39) as amd_number
      [(":" (4*4%x30-39) as amd_year)]
    ) as evs_amd
  }
  # "+COR:2015" / "/COR" — the COR spelling (the CEN spine consumes +AC itself)
  evs_cor = {
    (
      (("+" as supp_plus / "/" as supp_slash) ("COR" as cor_kind))
      [(1*%x30-39) as cor_number]
      [(":" (4*4%x30-39) as cor_year)]
    ) as evs_cor
  }
  # " AC:2015" — the space-separated AC spelling
  evs_ac = {
    (
      (" " as supp_space) ("AC" as cor_kind)
      [(1*%x30-39) as cor_number]
      [(":" (4*4%x30-39) as cor_year)]
    ) as evs_cor
  }
  # "+NA:2010" / "/NA" — the national annex
  evs_na = {
    (
      (("+" as supp_plus / "/" as supp_slash) "NA")
      [(":" (4*4%x30-39) as na_year)]
    ) as na
  }
  # The trailing language code (" et" / " en" / " et-en") is extracted by
  # the parse wrapper (Pubid::Evs.parse) BEFORE the grammar runs — the
  # CEN adopted_string is greedy over plain text and would swallow it.

  entry identifier: identifier

  test {
    accept "EVS-EN 18216:2026"
    accept "EVS-EN ISO 9001:2015/A1:2024"
    accept "EVS EN 196-1:2016"
    accept "EVS 921:2019"
    accept "EVS-TS 1:2019"
    accept "EVS-TR 1:2019"
    accept "EVS-ISO 9001:2015"
    accept "EVS-IEC 62368-1:2020"
    accept "EVS-EN 1993-1-1:2005+NA:2010"
    accept "EVS-EN 1993-1-1:2005/NA"
    accept "EVS-EN 50581:2012+COR:2015"
    accept "EVS-EN 50581:2012+AC:2015"
    accept "EVS-EN 71-1:2011 AMD1:2014"
    accept "prEVS-EN 100:2026"
    reject "nonsense"
  }

  bindings identifier {
    # The builder dispatches on the branch and supplement wrappers and
    # reads every leaf from inside them (evs/builder.rb: data[:adopted] is
    # rebuilt by the CEN builder, data[:intl]/data[:plain]/data[:na] are
    # read member-wise) — so all six wrappers bind uncast, the v1 nested
    # shape. Only the two flat spine fields the builder reads directly stay
    # scalar; the branch leaves are nested-only and bind no flat copies.
    draft_prefix -> draft_prefix (string)
    evs_separator -> evs_separator (string)
    adopted -> adopted (raw)
    intl -> intl (raw)
    plain -> plain (raw)
    evs_amd -> evs_amd (raw)
    evs_cor -> evs_cor (raw)
    na -> na (raw)
  }
}
