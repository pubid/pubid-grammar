# Port of lib/pubid/iana/parser.rb: "IANA <slug>[/<sub-slug>]", the
# optional prefix consumed and discarded.

grammar PubidIana version "0.1.0" edition 2 {
  slug_char = %x30-39 / %x41-5A / %x61-7A / %x2E / %x5F / %x2D
  slug = 1*slug_char
  identifier = ["IANA "] 1*slug_char as registry [slash 1*slug_char as sub_registry]
  slash = "/"
  entry identifier: identifier

  bindings identifier {
    registry -> registry (string)
    sub_registry -> sub_registry (string)
  }


  test {
    accept "IANA media-types"
    accept "media-types/application"
    reject "no sense"
  }
}
