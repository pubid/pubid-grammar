# Lua (subset): the general-purpose programming-language flavor of the
# rs#531 breadth program — after json/csv/ini, this proves PARG covers
# statement-oriented syntax (blocks, precedence chains, keyword
# guards, comments, multiple string forms), not only data formats.
#
# Subset (acceptance-complete for the shapes it declares): local and
# global assignments (single-name locals), function definitions and
# calls (call and member suffix chains), table constructors with
# array/record/indexed fields, if/elseif/else, while, numeric and
# generic for, do-blocks, return/break, the full operator precedence
# chain (or/and/comparison/concat/additive/multiplicative/unary/ # length), short strings ('' and "") with backslash escapes, long
# brackets [[ ]], decimal and hex numerals, -- line comments.
#
# Acceptance is the gate. Two documented supersets: an expression
# statement accepts any expression (Lua restricts it to calls and
# assignments — the subset accepts the superset); flat precedence
# chains accept the same strings as Lua, with associativity a
# tree-shape matter outside the subset's scope.

grammar Lua version "1.0.0" edition 2 {
  ws = *( %x20 / %x09 / %x0A / %x0D )
  nl = %x0A / %x0D

  ## Keyword characters and names. A name excludes the reserved words
  ## via a negative lookahead over the keyword list at the START.
  namechar = %x41-5A / %x61-7A / %x5F / %x30-39
  nametrain = ( ( %x41-5A / %x61-7A / %x5F ) *( namechar ) ) as nametrain

  kw_and = %i"and"
  kw_break = %i"break"
  kw_do = %i"do"
  kw_elseif = %i"elseif"
  kw_else = %i"else"
  kw_end = %i"end"
  kw_false = %i"false"
  kw_for = %i"for"
  kw_function = %i"function"
  kw_if = %i"if"
  kw_in = %i"in"
  kw_local = %i"local"
  kw_nil = %i"nil"
  kw_not = %i"not"
  kw_or = %i"or"
  kw_repeat = %i"repeat"
  kw_return = %i"return"
  kw_then = %i"then"
  kw_true = %i"true"
  kw_while = %i"while"
  kw_any = ( kw_and / kw_break / kw_do / kw_elseif / kw_else / kw_end / kw_false / kw_for / kw_function / kw_if / kw_in / kw_local / kw_nil / kw_not / kw_or / kw_repeat / kw_return / kw_then / kw_true / kw_while )

  name = ( !( kw_any !namechar ) nametrain ) as name

  ## Comments: line-scoped by construction (0x0A/0x0D are below the
  ## 0x20 floor of the run), newline optional at end of input.
  comment = ( "--" *( %x09 / %x20-10FFFF ) [ nl ] ) as comment

  ## Numerals: hex (0x/0X) or decimal with optional fraction and
  ## exponent.
  hexdig = %x30-39 / %x41-46 / %x61-66
  digit = %x30-39
  number = ( %x30 ( %x78 / %x58 ) 1*hexdig / digit [ *digit [ "." 1*digit ] [ ( %x65 / %x45 ) [ %x2B / %x2D ] 1*digit ] ] ) as number

  ## Short strings: single or double quoted, backslash escapes any
  ## single char; long brackets: [[ ... ]] with ]] excluded from the
  ## run (the first close ends it).
  short_string = ( %x22 *( "\\" ( %x00-10FFFF ) / %x20-21 / %x23-5B / %x5D-10FFFF ) %x22 / %x27 *( "\\" ( %x00-10FFFF ) / %x20-26 / %x28-5B / %x5D-10FFFF ) %x27 ) as short_string
  long_bracket = ( "[[" *( %x00-5C / %x5E-10FFFF ) "]]" ) as long_bracket

  ## Expressions: the precedence chain, flat chains per level.
  exp = ( or_e ) as exp
  or_e = and_e *( ws kw_or ws and_e )
  and_e = cmp_e *( ws kw_and ws cmp_e )
  cmp_e = bnot_e *( ws ( "==" / "~=" / "<=" / ">=" / "<" / ">" ) ws bnot_e )
  bnot_e = add_e *( ws ".." ws add_e )
  add_e = mul_e *( ws ( "+" / "-" ) ws mul_e )
  mul_e = unary_e *( ws ( "*" / "/" / "%%" ) ws unary_e )
  unary_e = *( ( %i"not" !namechar / "#" / "-" ) ws ) postfix_e
  postfix_e = ( simple_e *( ws ( "." ws name / "[" ws exp ws "]" / ws ":" ws name ws args / ws args ) ) ) as postfix_e

  args = ( "(" ws [ exp *( ws "," ws exp ) ] ws ")" / tablector / short_string / long_bracket ) as args

  simple_e = ( %i"nil" !namechar / %i"true" !namechar / %i"false" !namechar / number / short_string / long_bracket / function_def / tablector / name ) as simple_e

  function_def = ( kw_function ws function_body ) as function_def
  function_body = ( "(" ws [ name *( ws "," ws name ) ] ws ")" ws block kw_end ) as function_body

  tablector = ( "{" ws [ field *( ws fieldsep ws field ) ws [ fieldsep ] ] ws "}" ) as tablector
  fieldsep = "," / ";"
  field = ( "[" ws exp ws "]" ws "=" ws exp / name ws "=" ws exp / exp ) as field

  ## Statements.
  block = *( statement 1*( %x20 / %x09 / %x0A / %x0D / comment ) ) [ statement ] [ last_statement ws ]
  statement = ( kw_local ws name ws "=" ws exp / kw_function ws name ws function_body / if_block / while_block / numeric_for / generic_for / kw_do ws block kw_end / var ws "=" ws exp / call_statement ) as statement
  var = ( name ws *( suffix_member ) ) as var
  call_statement = ( name ws *( suffix_member ) ws suffix_call ws *( suffix_member / suffix_call ) ) as call_statement
  suffix_member = ( ws "." ws name / ws "[" ws exp ws "]" ) as suffix_member
  suffix_call = ( ws ":" ws name ws args / ws args ) as suffix_call

  if_block = ( kw_if ws exp ws kw_then ws block *( ws kw_elseif ws exp ws kw_then ws block ) [ ws kw_else ws block ] ws kw_end ) as if_block
  while_block = ( kw_while ws exp ws kw_do ws block kw_end ) as while_block
  numeric_for = ( kw_for ws name ws "=" ws exp ws "," ws exp [ ws "," ws exp ] ws kw_do ws block kw_end ) as numeric_for
  generic_for = ( kw_for ws name ws "," ws name ws kw_in ws exp ws kw_do ws block kw_end ) as generic_for
  last_statement = ( kw_return [ ws exp ] / kw_break ) as last_statement

  chunk = *( comment ws ) ws [ block ] ws

  entry main: chunk

  test {
    accept "x = 1"
    accept "local y = 2"
    accept "t = {1, 2, x = 3, ['k'] = 4}"
    accept "function f(a, b) return a + b end"
    accept "g = function (x) return x end"
    accept "if x then y() elseif z then w() else v() end"
    accept "while i < 10 do i = i + 1 end"
    accept "for i = 1, 10 do print(i) end"
    accept "for k, v in pairs(t) do print(k, v) end"
    accept "s = 'hello\\nworld'"
    accept "s = \"a\\\"b\""
    accept "s = [[long]]"
    accept "n = 0xFF"
    accept "-- a comment\nx = 1 -- trailing"
    accept "m = t.field:method(1)(2).rest"
    accept "return a or b and not c"
    accept "a = b .. 'x' * 2 - 1 / #t"
    accept "do local z = 3 end"
    reject "x = "
    reject "= 1"
    reject "if then end"
    reject "t = {,}"
    reject "end"
    reject "for = 1"
    reject "x = 0x"
    reject "s = 'unterminated"
    reject "t = [[unclosed"
  }
}