# Port of lib/pubid/ieee/parser.rb — the largest flavor: P-prefixed
# drafts (draft status/version/date families, =D ISO stages, /FDIS
# family), approved drafts, ANSI P forms, historical S-designations,
# corrigendum/interpretation/conformance-lead forms, multi-numbered and
# CSA dual-published identifiers, IEEE/ASTM SI/PSI, no-prefix forms,
# joint ISO/IEC/IEEE development formats, IEC/IEEE copublished labels,
# the relationship/parenthetical machinery, book nicknames, redlines,
# and title portions. The Aiee/Ire/Nesc sub-parsers are `use`d. The
# huge parse() normalization pipeline (rev/relaton/joint-stage
# spellings, entity decoding, paren balancing) is Tier-3 preprocessing
# outside the grammar. Source deviations: the duplicated
# combined_aiee_identifier branch is emitted once; "Sept"/"Sep"
# (and dotted-month) orders are lint-forced longest-first.
#
# Edition-2 conversion. The builder reads flat scalars with
# extract_value and dispatches on wrapper hashes, so leaf captures bind
# (string) and branch/wrapper captures bind (raw):
# - the zero-width markers are re-spelled as real-token captures (the
#   cie separator precedent): printed_dash_year / printed_month_year
#   capture their branch's leading separator (presence is what every
#   builder read checks), iec_label_dash captures the dash it marked,
#   the dead stage_embedded marker is dropped (nothing read it), and
#   iso_published captures the joint head choice (raw) — every read of
#   it sits behind a nil-iso_stage gate or the iso_stage elsif, so the
#   wider presence set is inert exactly where v1's was narrow.
# - the ([dash]) as draft_dash / ([rev_sep] as rev_sep) /
#   ([...] as suffix) capture-over-OPTIONAL landmines are re-spelled
#   [ (x) as y ] (parsanol-ruby#394: when the optional does not
#   participate, ruby/native omit the key but wasm emits "").
# - year_digits / digits / yearish / type_word bodies inline at every
#   capture site (a capture over a sequence/repetition rule ref expands
#   to node lists); pure literal/class alternation refs (month_name,
#   publisher, organization, dash, rev_sep...) stay refs and bind as
#   spans.
# - nested-only captures that collide with a top-level name rename with
#   the builder (a bound leak would surface the nested value where v1
#   kept the key absent): draft_date's month/year/day/dash_* ->
#   draft_date_*, the draft_version rule's dash_* -> draft_version_*,
#   fdraft's month/year -> fdraft_*, reaffirmed's year ->
#   reaffirmed_year. The builder reads the renamed keys at their nested
#   sites only.

use aiee
use ire
use nesc

grammar PubidIeee version "0.1.0" edition 2 {
  digit = %x30-39
  upper = %x41-5A
  lower = %x61-7A
  letter = %x41-5A / %x61-7A
  digits = 1*%x30-39
  space = " "
  dash = "-" / "&#x2013;" / "–"
  dot = "."
  slash = "/"
  stage_sep = slash / "_"
  comma = ", "
  non_nl = %x01-09 / %x0B-10FFFF
  non_rparen = %x01-27 / %x2A-10FFFF
  non_rbracket = %x01-5C / %x5E-10FFFF
  non_comma_rparen = %x01-28 / %x2A-2B / %x2D-10FFFF
  non_digit_nl = %x01-09 / %x0B-2F / %x3A-10FFFF
  alnum_char = %x30-39 / %x41-5A / %x61-7A

  year_digits = (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39))
  month_numeric = (("0" %x31-39)) / (("1" %x30-32))
  month_name = {
    "Sept." / "Oct." / "Nov." / "Dec." / "Jan." / "Feb." / "Mar." / "Apr." / "Jun." / "Jul." / "Aug." / "September" / "November" / "December" / "February" / "August" / "June" / "January" / "March" / "April" / "October" / "July" / "May" / "Sept" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec"
  }

  date_with_month_text = ((month_name) as month [space] (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as year)
  date_with_month_numeric = ((((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as year dash (month_numeric) as month)
  date_year_only = ((((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as year)
  date_standalone = (date_with_month_text / date_with_month_numeric / date_year_only)
  organization = {
    "IEEE" / "AIEE" / "ANSI" / "ASA" / "ANS" / "IEC" / "ISO" / "ASTM" / "CSA" / "ASME" / "NACE" / "NSF" / "ASHRAE" / "NCTA" / "AESC" / "EIA" / "USEMCSC" / "AMPP" / "USAS" / "EAB" / "MPAI"
  }
  complex_org_prefix = "ANSI/IEEE-ANS" / "ANSI/IEEE" / "ANSI"
  characteristic_ieee_number = (("C" 2%x30-39 dot 1*%x30-39 *%x61-7A)) / (("802" dot 1*%x30-39 *%x61-7A)) / (("P" 1*%x30-39))
  publisher = ((complex_org_prefix)) as publisher / ((organization)) as publisher
  copublisher = {
    (("/ISO/IEC")) as copublisher / (("/IEC/ISO")) as copublisher / ((slash [space] ((organization)) as copublisher))
  }
  conformance = {
    (((([space] slash "Conformance" ((1*%x30-39)) as conf_number ([space] dash [space]) (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as conf_year)))) as conformance
  }
  ashrae_copub = {
    ((((slash "ASHRAE" space [("Guideline" space)] ((1*%x30-39)) as ashrae_number [(([space] dash [space]) (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as ashrae_year)]))) as ashrae_copub)
  }
  ieee_crossref = {
    ((((slash "C" 1*%x30-39 dot 1*%x30-39 dot 1*%x30-39 ([space] dash [space]) (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39))))))) as ieee_crossref)
  }
  ipcea_copub = ((((slash "IPCEA" space (1*(%x41-5A / %x61-7A / %x30-39 / "." / dash))))) as ipcea_copub)
  s_designation = {
    ([(publisher space)] [((("Draft Std" / "STD" / "Standard" / "Std No." / "Std" / "PTC" / (("N" / "n") "o.") / (("N" / "n") "o") / "No")) as type [space])] (("S" dash 1*%x30-39)) as s_number [ipcea_copub] [parenthetical])
  }
  # A dash group after the number is a PART, not more number (C1: the
  # part binds before the draft status and the year - the dash-continuation
  # swallowed "61850-9-3" whole, and the builder-side Code split came too
  # late for the separator and the P prefix).
  number = ((([("P")] *%x41-5A 1*%x30-39 *((1*%x30-39 / %x41-5A)) [%x61-7A])) as number)
  type_word = {
    "Draft Std" / "STD" / "Standard" / "Std No." / "Std" / "PTC" / (("N" / "n") "o.") / (("N" / "n") "o") / "No"
  }
  part = {
    ((dot / dash) !(("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) (1*(!(("REV" / "Rev" / "rev")) (%x30-39 / %x41-5A / %x61-7A)))) as part
  }
  subpart = {
    ((dot / dash / "_") !(("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) (1*(!(("REV" / "Rev" / "rev")) (%x30-39 / %x61-7A)) [(dot 1*%x30-39)])) as subpart
  }
  year = (((([space] (dot / dash) [space])) date_standalone ["(E)"]))
  draft_status = ((("Active Unapproved" / "Active Approved" / "Unapproved" / "Approved" / "Active") space))
  draft_prefix = (([space] ("/" / "_" / dash / space)))
  rev_word = ("REV" / "Rev" / "rev")
  rev_sep = (dash / "_" / dot / space / slash)
  # The lettered revision id ("REVi", "REVmc") is identity - the IEEE 802
  # series letter suffix - and its separator is preserved as printed
  # ("P802.11-REVmc" renders "P802.11-Revmc"; a glued "REVi" stays glued).
  # A draft-D token after the word is the DRAFT (the "REVD2.2" family), so
  # the lettered capture declines it. The word with no id is kept as the
  # rev_bare marker ("802.1AR-Rev/D2.2").
  rev_numbered = ([rev_sep] (rev_word) [space] (1*%x30-39) as revision)
  rev_lettered = {
    (([ ("-" / "&#x2013;" / "–" / "_" / "." / " " / "/") as rev_sep ]) (rev_word) (!(("D" %x30-39)) (1*(%x30-39 / %x41-5A / %x61-7A))) as revision)
  }
  rev_bare = (([ ("-" / "&#x2013;" / "–" / "_" / "." / " " / "/") as rev_sep ]) (rev_word) as rev_bare)
  rev_inline = ((rev_numbered) / (rev_lettered) / (rev_bare))
  draft_version = {
    (!(("R" dash)) [("D" !("IS"))] ((((1*2digit dot 1*2digit dot 1*2digit))) / ((((1*2digit dot 1*2digit [lower]))) / ((dot (!(("19" / "20") 2digit 0*2lower !(1*digit))) (1*((digit / upper / lower) / dot)))) / (((1*digit "+" 1*digit))) / (((1*digit [dot] "e" 1*digit))) / ((((dash) (!(("19" / "20") 2digit 0*2lower !(1*digit))) (1*(digit / upper / lower)) [(("-d") / (("_") *(digit / upper / lower)))])) / (((dash) (("19" / "20") 2digit 0*2lower !(1*digit)) as draft_version_dash_year [dash (month_numeric) as draft_version_dash_month]))) / (((1*(digit / upper / lower)) [(("-d") / (("_") *(digit / upper / lower)))]))) as draft_version_composite))
  }
  # A draft date may comma-join its month and year (", Feb, 2011")
  # - the canonical forced-comma render (IEEE publisher, dated draft).

  draft_date = {
    (((("," [space]) / space) (month_name) as draft_date_month [(space / comma)] (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year)) / ((space (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year)) / ((comma (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year)) / ((("," / space) (month_numeric) as draft_date_month (space / dash) (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year)) / (((([space] comma [space]) / space) (month_name) as draft_date_month (((space ((1*%x30-39)) as draft_date_day) (((("," / space / dash)) (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year))) / ([((space ((1*%x30-39)) as draft_date_day)) comma] (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year) / ((comma [space] (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year)) / ((space (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as draft_date_year))))) / (((([space] comma [space]) / space) (month_name) as draft_date_month [space] ((("0" %x30-39)) / (("1" %x30-32))) as draft_date_year)) / ((([space] dash [space]) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as draft_date_dash_year [dash (month_numeric) as draft_date_dash_month]))
  }
  fdraft = {
    ((((stage_sep ((("FDIS" / "CDV" / "CD" / "WD" / "PWI" / "NP")) as fdraft_stage [(((((("," [space]) / space) (month_name) as fdraft_month [space] (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as fdraft_year))) / (((("," / space) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as fdraft_year))))] [parenthetical]))) as fdraft))
  }
  draft = {
    ((draft_prefix (1*2draft_version) [((dot 1*%x30-39) as revision)] [((("=" (((("D" ("FDIS" / "CDV" / "PWI" / "DIS" / "WD" / "NP" / "CD"))) / (("FDIS" / "CDV" / "PWI" / "DIS" / "WD" / "NP" / "CD"))) as draft_iso_stage)) [(":" / dash) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as draft_stage_year] [[(dot / dash)] (1*%x30-39 0*1letter) as draft_iso_iteration]))] [draft_date])) as draft
  }
  revision_suffix = {
    ((slash "R" dash (1*(%x30-39 / %x41-5A / %x61-7A)) as revision [([space] dash [space]) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as dash_year [dash (month_numeric) as dash_month]])) / ((slash "D" dash) (slash "R" dash) (1*(%x30-39 / %x41-5A / %x61-7A)) as revision [([space] dash [space]) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as dash_year [dash (month_numeric) as dash_month]]) / (rev_numbered) / (rev_lettered)
  }
  edition = {
    ((((comma (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as edition_year " Edition"))) / ((((space / dash)) "Edition " ((1*%x30-39 dot 1*%x30-39)) as edition (((" - ")) / space / dash) (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as edition_year [(dash (2%x30-39) as edition_month)])))
  }
  part_subpart_year = {
    ((part (1*2subpart) year)) / ((part subpart year)) / ((part year)) / ((part subpart)) / (year) / (part)
  }
  # The corrigendum ordinal may carry a placeholder year ("Cor 1-201x")
  # and may be followed by the corrigendum's own draft (", D4, July
  # 2015"): a comma-form year wins before the trailing-comma eater that
  # hands the tail to the draft slot.
  # The corrigendum ordinal may carry a placeholder year ("Cor 1-201x"),
  # a comma year ("Cor 1, 2015"), or hand its trailing comma to the
  # corrigendum's own draft (", D4, July 2015") — three alternatives,
  # no mid-alternative backtracking.
  # A corrigendum year: 4-%x30-39, or the 201x-style pre-publication placeholder.
  yearish = ((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) / ("20" ("1" / "0") ("x" / "X" / %x30-39)))
  corrigendum = {
    ((("_" / slash / dash / space) ("Corrigendum" / "Cor") [(dash / dot / space)] [space] [1*%x30-39 as cor_number] [ ( (comma !yearish [space] draft as cor_draft)   / (comma (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39) / ("20" ("1" / "0") ("x" / "X" / %x30-39))) as cor_year)   / ((dash / ":" / space) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39) / ("20" ("1" / "0") ("x" / "X" / %x30-39))) as cor_year) ) ]) as corrigendum)
  }
  amendment = {
    (((((("_" / slash / dash / space)) (("Amendment" / "Amd")) [(dash / dot / space)] [space] [1*%x30-39 as amd_number] [((dash / ":" / space) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as amd_year)]))) as amendment)
  }
  interpretation = {
    ((((slash "INT" [((dash / ":" / space) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as int_year)]))) as interpretation)
  }
  reaffirmed = {
    (((((("Reaffirmed " (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as reaffirmed_year))) / ((([space] ("(R" (((("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)))) as reaffirmed_year ")")))))) as reaffirmed)
  }
  redline = ((((space [(dash space)] (("Redline" / "REDLINE" / "redline"))))) as redline)
  book_nickname = ((space "[" (1*non_rbracket) as nickname "]"))
  relationship_revision_of = "Revision of " / "Revison of "
  relationship_amendment_to = "Amendment to "
  relationship_corrigendum_to = "Corrigendum to " / "Corrigenda to "
  relationship_incorporates = "incorporates " / "Incorporating " / "Incorporates "
  relationship_adoption_of = "Adoption of "
  relationship_supplement_to = "Supplement to "
  relationship_draft_amendment = "Draft Amendment to " / "DRAFT Amendment to "
  relationship_draft_revision = "Draft Revision of "
  relationship_reaffirmation = "Reaffirmation of "
  relationship_redesignation = "Redesignation of " / "redesignated as "
  relationship_supersedes = "Supersedes " / "Supercedes "
  relationship_previously_designated = "Previously designated as "
  relationship_includes = "Includes "
  relationship_type = {
    ((relationship_draft_amendment)) as draft_amendment_to / ((relationship_draft_revision)) as draft_revision_of / ((relationship_previously_designated)) as previously_designated_as / ((relationship_reaffirmation)) as reaffirmation_of / ((relationship_redesignation)) as redesignation_of / ((relationship_supersedes)) as supersedes / ((relationship_includes)) as includes / ((relationship_revision_of)) as revision_of / ((relationship_amendment_to)) as amendment_to / ((relationship_corrigendum_to)) as corrigendum_to / ((relationship_incorporates)) as incorporates / ((relationship_adoption_of)) as adoption_of / ((relationship_supplement_to)) as supplement_to
  }
  identifier_string = (1*((!(", and") !(" and") !(", ") !(" as amended by ") !relationship_break !(")")) non_nl))
  identifier_list = {
    (((1*((!(", and") !(" and") !(", ") !(" as amended by ") !relationship_break !(")")) (%x01-09 / %x0B-10FFFF))) as id) (*(((((", and") / (" and") / (", "))) (1*((!(", and") !(" and") !(", ") !(" as amended by ") !relationship_break !(")")) (%x01-09 / %x0B-10FFFF))) as id))))
  }
  as_amended_by_clause = {
    (((" as amended by IEEE's ") ((identifier_list)) as amendments)) / (((" as amended by ") ((identifier_list)) as amendments)) / ((" and its approved amendments") as approved_amendments)
  }
  relationship_separator = (([space] slash [space])) / (([space] ";" [space])) / (([space] dash [space]))
  relationship_break = (((relationship_separator)) [space] ((relationship_type)))
  relationship_clause = {
    (([space] "(" ((relationship_type)) as relationship_type ((identifier_list)) as related_ids [as_amended_by_clause] ((*(((relationship_separator) ((relationship_type)) as relationship_type ((identifier_list)) as related_ids [as_amended_by_clause]))) as additional_rels) ")"))
  }
  title_portion = ((":" space (1*non_nl) as title))
  approved_draft_suffix = ((space "- (Approved Draft)")) / ((space "(Approved Draft)"))
  additional_parameters = {
    (((([space] "(" [space] ((((reaffirmed))) / (("Revision of IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (("Revison of IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (("Revision to IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (("Revison to IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (((("DRAFT" / "Draft" / "draft")) " Amendment to " ((1*non_rparen)) as draft_amendment_to)) / (("Amendment to IEEE Std ") [space] ((1*non_rparen)) as amendment_to) / (("Adoption of ") ((1*non_rparen)) as adoption) / (("Notebooks") [space] ((1*non_comma_rparen)) as notebooks) / (("Standard Newspaper(s)") [space] ((1*non_comma_rparen)) as standard_newspapers) / (((1*non_rparen)) as parenthetical_content)) [")"]))) as parameters)
  }
  parenthetical = (relationship_clause / additional_parameters / (([space] ("P&V") as parenthetical_content)))
  iso_stage = {
    ((("FDIS" / (("FCD" [%x30-39])) / (("CDV" [%x30-39])) / (("DIS" [%x30-39])) / (("CD" [%x30-39])) / "WD" / "PWI" / "NP")) as iso_stage)
  }

  iec_ieee_copublished = ("IEC/IEEE" space !("P") &((*non_digit_nl %x30-39)) ((1*non_nl)) as content)
  # A draft date may comma-join its month and year ("D31, August, 2010")
  # as well as space-join it ("D8, June 2010") - both spellings ride
  # :draft_month/:draft_year so the date belongs to the draft.
  joint_development_ieee_format = {
    (("ISO/IEC/IEEE" / "IEEE/ISO/IEC" / "ISO/IEEE" / "IEC/IEEE" / "IEEE/CSA") as joint_publishers) space (("P") as project_marker) (1*%x30-39) as number [part [1*subpart]] [((stage_sep ("D" (1*%x30-39) [dot 1*%x30-39]) stage_sep ("FDIS" / ("FCD"   [%x30-39]) / ("CDV"   [%x30-39]) / ("DIS"   [%x30-39]) / ("CD"   [%x30-39]) / "WD" / "PWI" / "NP") as iso_stage)) / (slash space ("FDIS" / ("FCD"   [%x30-39]) / ("CDV"   [%x30-39]) / ("DIS"   [%x30-39]) / ("CD"   [%x30-39]) / "WD" / "PWI" / "NP") as iso_stage [((((((([comma] space) / (comma [space]) / ("," [space]) / space))) as printed_month_year (month_name) as month [space] (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as year)))]) / (stage_sep ("FDIS" / ("FCD"   [%x30-39]) / ("CDV"   [%x30-39]) / ("DIS"   [%x30-39]) / ("CD"   [%x30-39]) / "WD" / "PWI" / "NP") as iso_stage space (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as year) / (stage_sep ("FDIS" / ("FCD"   [%x30-39]) / ("CDV"   [%x30-39]) / ("DIS"   [%x30-39]) / ("CD"   [%x30-39]) / "WD" / "PWI" / "NP") as iso_stage ((((([space] dash [space])) as printed_dash_year (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as year [dash (month_numeric) as month])))) / ((stage_sep (("FDIS" / ("FCD"   [%x30-39]) / ("CDV"   [%x30-39]) / ("DIS"   [%x30-39]) / ("CD"   [%x30-39]) / "WD" / "PWI" / "NP")) as iso_stage slash "V" (1*%x30-39) as iso_stage_iteration)) / (slash 1*%x30-39 [dot 1*%x30-39] [dash (1*%x30-39) as draft_version_scalar]) / (slash "D" "=" ((("FDIS" [%x30-39]) / ("FCD" [%x30-39]) / ("CDV" [%x30-39]) / ("DIS" [%x30-39]) / ("CD" [%x30-39]) / ("WD" [%x30-39]) / ("PWI" [%x30-39]) / ("NP" [%x30-39])) as draft_iso_stage) [(((":" (("19" / "20") 2%x30-39)) / ("-" (("19" / "20") 2%x30-39) [2%x30-39]))) as draft_stage_year] [(dot (1*%x30-39 0*1letter)) as draft_iso_iteration]) / (slash "E" dash (1*%x30-39) as edition_e [([space] dash [space]) (("19" / "20") 2%x30-39 0*2%x61-7A !(1*%x30-39)) as edition_year [dash (month_numeric) as edition_month]]) / (slash "D" ([ (d