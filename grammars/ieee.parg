# Port of lib/pubid/ieee/parser.rb — the largest flavor: P-prefixed
# drafts (draft status/version/date families, =D ISO stages, /FDIS
# family), approved drafts, ANSI P forms, historical S-designations,
# corrigendum/interpretation/conformance-lead forms, multi-numbered and
# CSA dual-published identifiers, IEEE/ASTM SI/PSI, no-prefix forms,
# joint ISO/IEC/IEEE development formats, IEC/IEEE copublished labels,
# the relationship/parenthetical machinery, book nicknames, redlines,
# and title portions. The Aiee/Ire/Nesc sub-parsers are `use`d. The
# huge parse() normalization pipeline (rev/relaton/joint-stage
# spellings, entity decoding, paren balancing) is Tier-3 preprocessing
# outside the grammar. Source deviations: empty-marker captures
# (:iso_published, :part_dash, :printed_dash_year, :printed_month_year,
# :iec_label_dash) become bracketed optionals (which optional branch
# matched is derivable, so no information is lost); the duplicated
# combined_aiee_identifier branch is emitted once; "Sept"/"Sep"
# (and dotted-month) orders are lint-forced longest-first.

use aiee
use ire
use nesc

grammar PubidIeee version "0.1.0" {
  digit = %x30-39
  upper = %x41-5A
  lower = %x61-7A
  letter = upper / lower
  digits = 1*digit
  space = " "
  dash = "-" / "&#x2013;" / "–"
  dot = "."
  slash = "/"
  stage_sep = slash / "_"
  comma = ", "
  non_nl = %x01-09 / %x0B-10FFFF
  non_rparen = %x01-27 / %x2A-10FFFF
  non_rbracket = %x01-5C / %x5E-10FFFF
  non_comma_rparen = %x01-28 / %x2A-2B / %x2D-10FFFF
  non_digit_nl = %x01-09 / %x0B-2F / %x3A-10FFFF
  alnum_char = digit / upper / lower

  year_digits = (("19" / "20") 2digit 0*2lower !digits)
  month_numeric = (("0" %x31-39)) / (("1" %x30-32))
  month_name = "Sept." / "Oct." / "Nov." / "Dec." / "Jan." / "Feb." / "Mar." / "Apr." / "Jun." / "Jul." / "Aug." / "September" / "November" / "December" / "February" / "August" / "June" / "January" / "March" / "April" / "October" / "July" / "May" / "Sept" / "Jan" / "Feb" / "Mar" / "Apr" / "Jun" / "Jul" / "Aug" / "Sep" / "Oct" / "Nov" / "Dec"

  date_with_month_text = ((month_name) as month [space] ((year_digits)) as year)
  date_with_month_numeric = (((year_digits)) as year dash (month_numeric) as month)
  date_year_only = (((year_digits)) as year)
  date_standalone = (date_with_month_text / date_with_month_numeric / date_year_only)
  organization = "IEEE" / "AIEE" / "ANSI" / "ASA" / "ANS" / "IEC" / "ISO" / "ASTM" / "CSA" / "ASME" / "NACE" / "NSF" / "ASHRAE" / "NCTA" / "AESC" / "EIA" / "USEMCSC" / "AMPP" / "USAS" / "EAB" / "MPAI"
  complex_org_prefix = "ANSI/IEEE-ANS" / "ANSI/IEEE" / "ANSI"
  characteristic_ieee_number = (("C" 2digit dot digits *lower)) / (("802" dot digits *lower)) / (("P" 1*digits))
  publisher = ((complex_org_prefix)) as publisher / ((organization)) as publisher
  copublisher = (("/ISO/IEC")) as copublisher / (("/IEC/ISO")) as copublisher / ((slash [space] ((organization)) as copublisher))
  conformance = (((([space] slash "Conformance" ((1*digit)) as conf_number ([space] dash [space]) ((year_digits)) as conf_year)))) as conformance
  ashrae_copub = ((((slash "ASHRAE" space [("Guideline" space)] ((digits)) as ashrae_number [(([space] dash [space]) ((year_digits)) as ashrae_year)]))) as ashrae_copub)
  ieee_crossref = ((((slash "C" digits dot digits dot digits ([space] dash [space]) ((year_digits))))) as ieee_crossref)
  ipcea_copub = ((((slash "IPCEA" space (1*(letter / digit / "." / dash))))) as ipcea_copub)
  s_designation = ([(publisher space)] [(((type_word)) as type [space])] (("S" dash digits)) as s_number [ipcea_copub] [parenthetical])
  # A dash group after the number is a PART, not more number (C1: the
  # part binds before the draft status and the year - the dash-continuation
  # swallowed "61850-9-3" whole, and the builder-side Code split came too
  # late for the separator and the P prefix).
  number = ((([("P")] *upper digits *((digits / upper)) [lower])) as number)
  type_word = "Draft Std" / "STD" / "Standard" / "Std No." / "Std" / "PTC" / (("N" / "n") "o.") / (("N" / "n") "o") / "No"
  part = ((dot / dash) !(year_digits) (1*(!(("REV" / "Rev" / "rev")) alnum_char))) as part
  subpart = ((dot / dash / "_") !(year_digits) (1*(!(("REV" / "Rev" / "rev")) (digit / lower)) [(dot digits)])) as subpart
  year = (((([space] (dot / dash) [space])) date_standalone ["(E)"]))
  draft_status = ((("Active Unapproved" / "Active Approved" / "Unapproved" / "Approved" / "Active") space))
  draft_prefix = (([space] ("/" / "_" / dash / space)))
  rev_word = ("REV" / "Rev" / "rev")
  rev_sep = (dash / "_" / dot / space / slash)
  # The lettered revision id ("REVi", "REVmc") is identity - the IEEE 802
  # series letter suffix - and its separator is preserved as printed
  # ("P802.11-REVmc" renders "P802.11-Revmc"; a glued "REVi" stays glued).
  # A draft-D token after the word is the DRAFT (the "REVD2.2" family), so
  # the lettered capture declines it. The word with no id is kept as the
  # rev_bare marker ("802.1AR-Rev/D2.2").
  rev_numbered = ([rev_sep] (rev_word) [space] (1*digit) as revision)
  rev_lettered = (([rev_sep] as rev_sep) (rev_word) (!(("D" digit)) (1*alnum_char)) as revision)
  rev_bare = (([rev_sep] as rev_sep) (rev_word) as rev_bare)
  rev_inline = ((rev_numbered) / (rev_lettered) / (rev_bare))
  draft_version = (!(("R" dash)) [("D" !("IS"))] ((((1*2digit dot 1*2digit dot 1*2digit))) / ((((1*2digit dot 1*2digit [lower]))) / ((dot (!(year_digits)) (1*(alnum_char / dot)))) / (((digits "+" digits))) / (((digits [dot] "e" digits))) / ((((dash) (!(year_digits)) (1*alnum_char) [(("-d") / (("_") *alnum_char))])) / (((dash) (year_digits) as dash_year [dash (month_numeric) as dash_month]))) / (((1*alnum_char) [(("-d") / (("_") *alnum_char))]))) as draft_version))
  # A draft date may comma-join its month and year (", Feb, 2011")
  # - the canonical forced-comma render (IEEE publisher, dated draft).

  draft_date = (((("," [space]) / space) (month_name) as month [(space / comma)] ((year_digits)) as year)) / ((space ((year_digits)) as year)) / ((comma ((year_digits)) as year)) / ((("," / space) (month_numeric) as month (space / dash) ((year_digits)) as year)) / (((([space] comma [space]) / space) (month_name) as month (((space ((digits)) as day) (((("," / space / dash)) ((year_digits)) as year))) / ([((space ((digits)) as day)) comma] ((year_digits)) as year) / ((comma [space] ((year_digits)) as year)) / ((space ((year_digits)) as year))))) / (((([space] comma [space]) / space) (month_name) as month [space] ((("0" %x30-39)) / (("1" %x30-32))) as year)) / ((([space] dash [space]) (year_digits) as dash_year [dash (month_numeric) as dash_month]))
  fdraft = ((((stage_sep ((("FDIS" / "CDV" / "CD" / "WD" / "PWI" / "NP")) as fdraft_stage [(((((("," [space]) / space) (month_name) as month [space] (year_digits) as year))) / (((("," / space) (year_digits) as year))))] [parenthetical]))) as fdraft))
  draft = ((draft_prefix (1*2draft_version) [((dot digits) as revision)] [((("=" (((("D" ("FDIS" / "CDV" / "PWI" / "DIS" / "WD" / "NP" / "CD"))) / (("FDIS" / "CDV" / "PWI" / "DIS" / "WD" / "NP" / "CD"))) as draft_iso_stage)) [(":" / dash) (year_digits) as draft_stage_year] [[(dot / dash)] (digits 0*1letter) as draft_iso_iteration]))] [draft_date])) as draft
  revision_suffix = ((slash "R" dash (1*alnum_char) as revision [([space] dash [space]) (year_digits) as dash_year [dash (month_numeric) as dash_month]])) / ((slash "D" dash) (slash "R" dash) (1*alnum_char) as revision [([space] dash [space]) (year_digits) as dash_year [dash (month_numeric) as dash_month]]) / (rev_numbered) / (rev_lettered)
  edition = ((((comma (year_digits) as edition_year " Edition"))) / ((((space / dash)) "Edition " ((digits dot digits)) as edition (((" - ")) / space / dash) ((year_digits)) as edition_year [(dash (2digit) as edition_month)])))
  part_subpart_year = ((part (1*2subpart) year)) / ((part subpart year)) / ((part year)) / ((part subpart)) / (year) / (part)
  # The corrigendum ordinal may carry a placeholder year ("Cor 1-201x")
  # and may be followed by the corrigendum's own draft (", D4, July
  # 2015"): a comma-form year wins before the trailing-comma eater that
  # hands the tail to the draft slot.
  # The corrigendum ordinal may carry a placeholder year ("Cor 1-201x"),
  # a comma year ("Cor 1, 2015"), or hand its trailing comma to the
  # corrigendum's own draft (", D4, July 2015") — three alternatives,
  # no mid-alternative backtracking.
  # A corrigendum year: 4-digit, or the 201x-style pre-publication placeholder.
  yearish = ((year_digits) / ("20" ("1" / "0") ("x" / "X" / digit)))
  corrigendum = ((("_" / slash / dash / space) ("Corrigendum" / "Cor") [(dash / dot / space)] [space] [digits as cor_number] [ ( (comma !yearish [space] draft as cor_draft)   / (comma yearish as cor_year)   / ((dash / ":" / space) yearish as cor_year) ) ]) as corrigendum)
  amendment = (((((("_" / slash / dash / space)) (("Amendment" / "Amd")) [(dash / dot / space)] [space] [digits as amd_number] [((dash / ":" / space) (year_digits) as amd_year)]))) as amendment)
  interpretation = ((((slash "INT" [((dash / ":" / space) (year_digits) as int_year)]))) as interpretation)
  reaffirmed = (((((("Reaffirmed " ((year_digits)) as year))) / ((([space] ("(R" ((year_digits)) as year ")")))))) as reaffirmed)
  redline = ((((space [(dash space)] (("Redline" / "REDLINE" / "redline"))))) as redline)
  book_nickname = ((space "[" (1*non_rbracket) as nickname "]"))
  relationship_revision_of = "Revision of " / "Revison of "
  relationship_amendment_to = "Amendment to "
  relationship_corrigendum_to = "Corrigendum to " / "Corrigenda to "
  relationship_incorporates = "incorporates " / "Incorporating " / "Incorporates "
  relationship_adoption_of = "Adoption of "
  relationship_supplement_to = "Supplement to "
  relationship_draft_amendment = "Draft Amendment to " / "DRAFT Amendment to "
  relationship_draft_revision = "Draft Revision of "
  relationship_reaffirmation = "Reaffirmation of "
  relationship_redesignation = "Redesignation of " / "redesignated as "
  relationship_supersedes = "Supersedes " / "Supercedes "
  relationship_previously_designated = "Previously designated as "
  relationship_includes = "Includes "
  relationship_type = ((relationship_draft_amendment)) as draft_amendment_to / ((relationship_draft_revision)) as draft_revision_of / ((relationship_previously_designated)) as previously_designated_as / ((relationship_reaffirmation)) as reaffirmation_of / ((relationship_redesignation)) as redesignation_of / ((relationship_supersedes)) as supersedes / ((relationship_includes)) as includes / ((relationship_revision_of)) as revision_of / ((relationship_amendment_to)) as amendment_to / ((relationship_corrigendum_to)) as corrigendum_to / ((relationship_incorporates)) as incorporates / ((relationship_adoption_of)) as adoption_of / ((relationship_supplement_to)) as supplement_to
  identifier_string = (1*((!(", and") !(" and") !(", ") !(" as amended by ") !relationship_break !(")")) non_nl))
  identifier_list = ((((identifier_string)) as id) (*(((((", and") / (" and") / (", "))) ((identifier_string)) as id))))
  as_amended_by_clause = (((" as amended by IEEE's ") ((identifier_list)) as amendments)) / (((" as amended by ") ((identifier_list)) as amendments)) / ((" and its approved amendments") as approved_amendments)
  relationship_separator = (([space] slash [space])) / (([space] ";" [space])) / (([space] dash [space]))
  relationship_break = (((relationship_separator)) [space] ((relationship_type)))
  relationship_clause = (([space] "(" ((relationship_type)) as relationship_type ((identifier_list)) as related_ids [as_amended_by_clause] ((*(((relationship_separator) ((relationship_type)) as relationship_type ((identifier_list)) as related_ids [as_amended_by_clause]))) as additional_rels) ")"))
  title_portion = ((":" space (1*non_nl) as title))
  approved_draft_suffix = ((space "- (Approved Draft)")) / ((space "(Approved Draft)"))
  additional_parameters = (((([space] "(" [space] ((((reaffirmed))) / (("Revision of IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (("Revison of IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (("Revision to IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (("Revison to IEEE Std ") [space] ((1*non_rparen)) as revision_of) / (((("DRAFT" / "Draft" / "draft")) " Amendment to " ((1*non_rparen)) as draft_amendment_to)) / (("Amendment to IEEE Std ") [space] ((1*non_rparen)) as amendment_to) / (("Adoption of ") ((1*non_rparen)) as adoption) / (("Notebooks") [space] ((1*non_comma_rparen)) as notebooks) / (("Standard Newspaper(s)") [space] ((1*non_comma_rparen)) as standard_newspapers) / (((1*non_rparen)) as parenthetical_content)) [")"]))) as parameters)
  parenthetical = (relationship_clause / additional_parameters / (([space] ("P&V") as parenthetical_content)))
  iso_stage = ((("FDIS" / (("FCD" [digit])) / (("CDV" [digit])) / (("DIS" [digit])) / (("CD" [digit])) / "WD" / "PWI" / "NP")) as iso_stage)

  iec_ieee_copublished = ("IEC/IEEE" space !("P") &((*non_digit_nl digit)) ((1*non_nl)) as content)
  # A draft date may comma-join its month and year ("D31, August, 2010")
  # as well as space-join it ("D8, June 2010") - both spellings ride
  # :draft_month/:draft_year so the date belongs to the draft.
  joint_development_ieee_format = (("ISO/IEC/IEEE" / "IEEE/ISO/IEC" / "ISO/IEEE" / "IEC/IEEE" / "IEEE/CSA") as joint_publishers) space (("P") as project_marker) (digits) as number [part [1*subpart]] [((stage_sep ("D" (digits) [dot digits]) stage_sep ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage)) / (slash space ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage [((((([comma] space) / (comma [space]) / ("," [space]) / space) (month_name) as month [space] (year_digits) as year ("" as printed_month_year))))]) / (stage_sep ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage space (year_digits) as year) / (stage_sep ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage (([space] dash [space]) (year_digits) as year [dash (month_numeric) as month] ("" as printed_dash_year))) / ((stage_sep (("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP")) as iso_stage slash "V" (digits) as iso_stage_iteration)) / (slash digits [dot digits] [dash (digits) as draft_version]) / (slash "D" "=" ((("FDIS" [digit]) / ("FCD" [digit]) / ("CDV" [digit]) / ("DIS" [digit]) / ("CD" [digit]) / ("WD" [digit]) / ("PWI" [digit]) / ("NP" [digit])) as draft_iso_stage) [(((":" (("19" / "20") 2digit)) / ("-" (("19" / "20") 2digit) [2digit]))) as draft_stage_year] [(dot (digits 0*1letter)) as draft_iso_iteration]) / (slash "E" dash (1*digit) as edition_e [([space] dash [space]) (year_digits) as edition_year [dash (month_numeric) as edition_month]]) / (slash "D" (([dash]) as draft_dash) (1*(digit / ".")) as draft_version [((comma / space) (month_name) as draft_month [(space / comma)] (year_digits) as draft_year) / (comma (year_digits)) as draft_year]) / (space ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage [space "D" [dash] (1*(digit / ".")) as draft_version]) / (comma (("FDIS" / "FCD" / "CDV" / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP")) as iec_stage [digits] as stage_iteration)] [edition] [((([space] dash [space]) (year_digits) as year [dash (month_numeric) as month] ("" as printed_dash_year)) / (((([comma] space) / (comma [space]) / ("," [space]) / space) (month_name) as month [space] (year_digits) as year ("" as printed_month_year))) / ((comma) space (month_name) as month [space] (year_digits) as year) / (([space] dash [space]) (year_digits) as year))] [revision_suffix] [parenthetical]
  joint_development_iso_format = ((("ISO/IEC/IEEE" / "IEEE/ISO/IEC" / "IEEE/IEC/ISO" / "ISO/IEEE") as joint_publishers [space] ((iso_stage [space "Std"] space) / ((slash [space]) iso_stage [space "Std"] space) / ("" as iso_published [space]))) / ((("IEC/IEEE" / "IEEE/IEC") as joint_publishers [space] (((slash [space]) iso_stage / iso_stage) [space "Std"] space / (["Draft" space] &("P" digit) "" as iso_published [space]))))/ ((("ISO/IEC" / "IEEE") as joint_publishers [space] ((slash [space]) iso_stage / iso_stage) [space "Std"] space)))["P"] as project_marker (digits) as number [part [1*subpart]] [((":" (year_digits) as year) / (([space] dash [space]) (year_digits) as year [dash (month_numeric) as month] ("" as printed_dash_year)) / ((([comma] space) / (comma [space])) (month_name) as month [space] (year_digits) as year ("" as printed_month_year)))] [space "(" (1*non_rparen) as edition_marker ")"] [((slash "D" "=" (("FDIS" / "FCD" / "CDV" / ("DIS" [digit]) / ("CD" [digit]) / "WD" / "PWI" / "NP") as draft_iso_stage) [(((":" (("19" / "20") 2digit)) / ("-" (("19" / "20") 2digit) [2digit]))) as draft_stage_year] [(dot (digits 0*1letter) as draft_iso_iteration)]) / (stage_sep "D" (([dash]) as draft_dash) (1*(digit / ".")) as draft_version [((([comma] space) / (comma [space])) (month_name) as draft_month [(space / comma)] (year_digits) as draft_year) / (comma (year_digits) as draft_year) / ((([space] dash [space]) (year_digits) as dash_year [dash (month_numeric) as dash_month]))]) / (space "D" [dash] (1*(digit / ".")) as draft_version [((([comma] space) / (comma [space])) (month_name) as draft_month [(space / comma)] (year_digits) as draft_year) / (comma (year_digits) as draft_year) / ((([space] dash [space]) (year_digits) as dash_year [dash (month_numeric) as dash_month]))]) / (slash "D" (1*(digit / ".")) as draft_version [space "D" [dash] (1*(digit / ".")) as draft_version [((([comma] space) / (comma [space])) (month_name) as draft_month [(space / comma)] (year_digits) as draft_year) / (comma (year_digits) as draft_year) / ((([space] dash [space]) (year_digits) as dash_year [dash (month_numeric) as dash_month]))]]) / (slash ("ED" (1*digit)) as draft_version [((([comma] space) / (comma [space])) (month_name) as draft_month [(space / comma)] (year_digits) as draft_year) / (comma (year_digits) as draft_year)]) / (slash "E" dash (1*digit) as edition_e [([space] dash [space]) (year_digits) as edition_year [dash (month_numeric) as edition_month]]))] [slash "Amd" [dot / space] (digits) as amd_number [(":" / dash) (year_digits) as amd_year]] [corrigendum] [edition] [revision_suffix] [parenthetical] [redline]
  joint_development_ieee_tail_format = (("ISO/IEC/IEEE" / "IEEE/ISO/IEC" / "ISO/IEEE" / "IEC/IEEE" / "IEEE/CSA") as joint_publishers) space (("P") as project_marker) (digits) as number (part [1*subpart]) [((stage_sep ("D" (digits) [dot digits]) stage_sep ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage)) / (slash space ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage [((((([comma] space) / (comma [space]) / ("," [space]) / space) (month_name) as month [space] (year_digits) as year ("" as printed_month_year))))]) / (slash ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as tail_iso_stage ((((([comma] space) / (comma [space]) / ("," [space]) / space) (month_name) as month [space] (year_digits) as year ("" as printed_month_year))))) / (stage_sep ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage space (year_digits) as year) / (stage_sep ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage (([space] dash [space]) (year_digits) as year [dash (month_numeric) as month] ("" as printed_dash_year))) / ((stage_sep (("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP")) as iso_stage slash "V" (digits) as iso_stage_iteration)) / (slash digits [dot digits] [dash (digits) as draft_version]) / (slash "D" "=" ((("FDIS" [digit]) / ("FCD" [digit]) / ("CDV" [digit]) / ("DIS" [digit]) / ("CD" [digit]) / ("WD" [digit]) / ("PWI" [digit]) / ("NP" [digit])) as draft_iso_stage) [(((":" (("19" / "20") 2digit)) / ("-" (("19" / "20") 2digit) [2digit]))) as draft_stage_year] [(dot (digits 0*1letter)) as draft_iso_iteration]) / (slash "E" dash (1*digit) as edition_e [([space] dash [space]) (year_digits) as edition_year [dash (month_numeric) as edition_month]]) / (slash "D" (([dash]) as draft_dash) (1*(digit / ".")) as draft_version [((comma / space) (month_name) as draft_month [(space / comma)] (year_digits) as draft_year) / (comma (year_digits)) as draft_year]) / (space ("FDIS" / ("FCD"   [digit]) / ("CDV"   [digit]) / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP") as iso_stage [space "D" [dash] (1*(digit / ".")) as draft_version]) / (comma (("FDIS" / "FCD" / "CDV" / ("DIS"   [digit]) / ("CD"   [digit]) / "WD" / "PWI" / "NP")) as iec_stage [digits] as stage_iteration)] [edition] [((([space] dash [space]) (year_digits) as year [dash (month_numeric) as month] ("" as printed_dash_year)) / (((([comma] space) / (comma [space]) / ("," [space]) / space) (month_name) as month [space] (year_digits) as year ("" as printed_month_year))) / ((comma) space (month_name) as month [space] (year_digits) as year) / (([space] dash [space]) (year_digits) as year))] [revision_suffix] [parenthetical]
  joint_development_iso_iec_edition = ((("ISO/IEC") as joint_publishers) space ("" as iso_published) [("P")] as project_marker (digits) as number [((dot (digits)) as part) / ((dash ("" as iec_label_dash) !(year_digits) (digits) as part))] (":" [space] (year_digits) as year) [space] parenthetical)
  joint_development_embedded_stage = ((("" as stage_embedded) (((((("ISO/IEC/IEEE" / "IEEE/ISO/IEC" / "IEEE/IEC/ISO" / "ISO/IEEE" / "IEC/IEEE" / "IEEE/IEC" / "ISO/IEC" / "IEEE"))) as joint_publishers) space [("P") as project_marker] ((digits)) as number [((((dot / dash) !(year_digits) ((digits)) as part)))] dot (iso_stage) (!(digit / letter)) [(((((":" ((year_digits)) as year))) / ((((([space] dash [space]) ((year_digits)) as year [(dash (month_numeric) as month)])))) / (((((("," [space]) / space) (month_name) as month [space] ((year_digits)) as year))))))]))))
  number_first_identifier = ((number [((((([space] dash [space]) ((year_digits)) as year))))] space (((((publisher)) ((*copublisher) as copublishers)) as publishers)) space [(((type_word)) as type [space])] (((0*non_nl)) as title)))
  ieee_p_identifier = ([(("IEEE") as publisher space)] ((number)) [((part_subpart_year / edition))] [(slash ((digits) as draft_version)) as digit_draft] [fdraft] [trailing_month_year] [corrigendum] [rev_inline] [draft] [revision_suffix] [trailing_month_year] [corrigendum] [parenthetical])
  ansi_p_identifier = (((((("ANSI"))) as publisher) space "P" [space] ((number)) [((part_subpart_year / edition))] [trailing_month_year] [corrigendum] [rev_inline] [draft] [revision_suffix] [trailing_month_year] [((("," [space]) / space) (year_digits) as trailing_year)] [corrigendum] [parenthetical]))
  ieee_draft_p_identifier = ((([((((("IEEE")) as publisher ((*copublisher) as copublishers)) as publishers) space)] [((draft_status)) as draft_status] "Draft" space ((number)) [((part_subpart_year / edition))] [((((space (month_name) as trailing_month space ((year_digits)) as trailing_year)) / ((space (month_numeric) as trailing_month ((space / dash)) ((year_digits)) as trailing_year))))] [rev_inline] [draft] [((((comma [space] (month_name) as trailing_month space ((year_digits)) as trailing_year))))] [revision_suffix] [((((comma [space] (month_name) as trailing_month space ((year_digits)) as trailing_year))))] [corrigendum] [parenthetical])))
  ieee_approved_draft_identifier = (((((("IEEE"))) as publisher) space "Approved" space ((("Draft Std" / "Std"))) as type space [("P")] ((number)) [((part_subpart_year / edition))] [rev_inline] [draft] [revision_suffix] [parenthetical]))
  trailing_month_year = ((("," [space]) / space) (month_name) as trailing_month space (year_digits) as trailing_year) / ((("," [space]) / space) (month_numeric) as trailing_month (space / dash) (year_digits) as trailing_year)

  combined_aiee_identifier = ((&(aiee.aiee_identifier) ((aiee.aiee_identifier)) as first_aiee) space "and" space ((aiee.aiee_identifier)) as second_aiee)
  aiee_identifier = ((&(aiee.aiee_prefix) ((aiee.aiee_identifier)) as aiee))
  ire_identifier = ((&((ire.ire_identifier_year_first / ire.ire_identifier_prefix_first)) ((ire.ire_identifier)) as ire))
  # The optional "IEEE Std " prefix precedes the guard: IEEE catalogues
  # NESC documents with the prefix ("IEEE Std C2.2012.Preprint"), so a
  # guard anchored at position 0 would reject every prefixed spelling.
  nesc_identifier = (([("IEEE" space "Std" space)] &((nesc.draft_nesc / nesc.preprint_proposal / nesc.name_first / nesc.c2_preprint / nesc.c2_standard / nesc.year_first)) (((nesc.nesc_identifier)) as nesc)))
  psi_draft = (((slash "D" [dash] (((digits)) as draft_version))))
  psi_date = ((comma ((month_name / month_numeric) as month) (space / dash) (year_digits) as year) / (([space] dash [space]) (year_digits) as year [(dash (2digit) as month)]))
  ieee_astm_si_psi = ((((("IEEE/ASTM" / "IEEE/ ASTM" / "IEEE"))) as publishers) space (("PSI" / "SI")) as si_type ((space / ".")) ((digits)) as number [(((("." ((year_digits)) as year))))] [(((psi_draft [psi_date])) / ((psi_date [psi_draft])))] [parenthetical])
  no_prefix_ieee = ((((characteristic_ieee_number)) as number) ([((dash (upper / lower)))] as suffix) ([((([space] dash [space]) (year_digits)))] as year) [rev_inline] [draft] [(("(E)") / ("(F)"))] [parenthetical])
  # Publisherless form of the generic tail (the original parser's
  # `parameters((organizations >> space).maybe)` route): LAST in the
  # choice so it only accepts what every publisher-led alternative
  # rejected — joint and copublished shapes still fail (their letter
  # prefixes cannot satisfy `number`), preserving the rejection
  # contract downstream fallbacks rely on.
  # The IEEE-face designator for an ISO-staged draft (pubid#203): an
  # IEEE-printed identifier whose ISO stage rides a D= designator with
  # the IEEE date convention ("IEEE P15026.2/D=FDIS-201008"). Final
  # alternative: it only accepts what every publisher-led rule above
  # rejected, so plain IEEE drafts keep their existing routes.
  ieee_iso_draft_designation = ((publisher) space ["Draft" space] [((draft_status)) as draft_status] [("P") as project_marker] (digits) as number [part [1*subpart]] (slash "D" "=" ((("FDIS" [digit]) / ("FCD" [digit]) / ("CDV" [digit]) / ("DIS" [digit]) / ("CD" [digit]) / ("WD" [digit]) / ("PWI" [digit]) / ("NP" [digit])) as iso_stage)) [(("-" (("19" / "20") 2digit) [2digit])) as draft_stage_year] [((dash (month_name) [space] (year_digits)) as draft_stage_year)])
  publisherless_ieee = ([(((type_word)) as type [space])] ((number)) [((part_subpart_year / edition))] [corrigendum] [rev_inline] [draft] [revision_suffix] [parenthetical])
  corrigendum_identifier = ([((((((publisher)) ((*copublisher) as copublishers)) as publishers) space))] [(((type_word)) as type [space])] ((number)) [(part_subpart_year)]) as base ((slash / dash / space)) "Cor" [(dash / dot / space)] [space] ((digits)) as cor_number [ ( (comma !yearish [space] draft as cor_draft)   / (comma yearish as cor_year)   / ((dash / ":" / space) yearish as cor_year) ) ] [draft] [parenthetical]
  interpretation_identifier = ([((((((publisher)) ((*copublisher) as copublishers)) as publishers) space))] [(((type_word)) as type [space])] ((number)) [(part_subpart_year)]) as base ((slash / dash / space)) "INT" [((dash / ":" / space) ((year_digits)) as int_year)] [parenthetical]
  conformance_identifier = ([((((((publisher)) ((*copublisher) as copublishers)) as publishers) space))] [(((type_word)) as type [space])] ((number)) [(part_subpart_year)]) as base ((slash / dash / space)) "Conformance" ((1*digit)) as conf_number ([space] dash [space]) ((year_digits)) as conf_year [parenthetical]
  multi_numbered_identifier = ((((((([(publisher space)] [(((type_word)) as type [space])] ((number)) [((part_subpart_year / edition))]))) as primary_identifier) ((((slash "C" digits dot digits dot digits ([space] dash [space]) ((year_digits)))) as secondary_crossref)))) / ((((((comma space) [(((type_word)) as type [space])] ((number)) ([space] dash [space]) ((year_digits)))) as secondary_joint))))
  csa_dual_published = (((((((publisher) space) [(((type_word)) as type [space])] ((number)) [((part_subpart_year / edition))])) as ieee_portion) slash "CSA" space ((((("C" 2digit dot digit space ("No" / "NO") dot space (1*(digit / ".")) ((dash / ":")) 2digit)) / (("C" (1*(digit / ".")) dash 2digit)) / (("C" 2digit dot digit space ("No" / "NO") dot space (1*(digit / ".")) ":" 2digit)) / (("C" (1*(digit / ".")) ":" 2digit))) as csa_portion))))
  identifier = combined_aiee_identifier / aiee_identifier / ire_identifier / nesc_identifier / ieee_astm_si_psi / multi_numbered_identifier / csa_dual_published / s_designation / corrigendum_identifier / interpretation_identifier / conformance_identifier / joint_development_ieee_format / joint_development_iso_format / joint_development_ieee_tail_format / joint_development_iso_iec_edition / joint_development_embedded_stage / iec_ieee_copublished / number_first_identifier / ieee_approved_draft_identifier / ieee_draft_p_identifier / ieee_p_identifier / ansi_p_identifier / (((((((((publisher)) ((*copublisher) as copublishers)) as publishers) space))))) [((draft_status)) as draft_status] [(("Draft Std") as type [space])] [(((type_word)) as type [((space "No" space))] [space])] ((number)) [((part_subpart_year / edition))] [corrigendum] [amendment] [interpretation] [conformance] [ashrae_copub] [ieee_crossref] [rev_inline] [draft] [revision_suffix] [trailing_month_year] [ashrae_copub] [book_nickname] [corrigendum] [edition] [parenthetical] [book_nickname] [redline] [title_portion] [approved_draft_suffix] / no_prefix_ieee / publisherless_ieee / ieee_iso_draft_designation

  entry identifier: identifier

  test {
    # the D= designator accepts the glued stage iteration on every
    # token ("FDIS1", "CD1", "WD2") - the lossless face the builder
    # renders ("D=FDIS1-201607") must re-parse (track 01: 9349/1052/1090)
    accept "IEEE P29119-5/D=FDIS1-201607"
    accept "IEEE P12207/D=CD1"
    accept "IEEE P15026.2/D=WD2-201008"
    # the D= designator accepts the glued stage iteration on every
    # token ("FDIS1", "CD1", "WD2") - the lossless face the builder
    # renders ("D=FDIS1-201607") must re-parse (track 01: 9349/1052/1090)
    accept "IEEE P29119-5/D=FDIS1-201607"
    accept "IEEE P12207/D=CD1"
    accept "IEEE Draft P12207/D=CD1"
    accept "IEEE P15026-3/D=DIS2-January 2015"
    # the stage-first faces are untouched by the D= extension
    accept "IEC/IEEE P63113 CD4, April 2019"
    accept "ISO/IEC/IEEE P24641_D3_CD2,March 2021"
    # the joint-draft underscore dialect parses directly (no shim):
    # "_CDV/V3" keeps its /V iteration, "_DIS"/"_FDIS" stage words
    accept "IEC/IEEE P63195_CDV/V3, February 2020"
    accept "ISO/IEC/IEEE P24641_D2_CD, June 2020"
    accept "ISO/IEC/IEEE P24748-3/D3_FDIS, April 2020 (E)"
    accept "ISO/IEC/IEEE P26511.2_FDIS 2018"
    accept "ISO/IEC/IEEE P24641_D3_CD2,March 2021"
    # crawled stray slash between the joint publisher list and the stage
    accept "ISO/IEC/IEEE/ FDIS 15288"
    accept "ISO/IEC/IEEE/FDIS 15288"
    # slash-SPACE stage, stage+dash-date, space stage, space stage +
    # space draft, space/underscore draft after a stage-first number (no shim):
    accept "ISO/IEC/IEEE P16085/ FDIS, August 2020"
    accept "ISO/IEC/IEEE P15288/CD2-2013-09 (Revision of ISO/IEC/IEEE 15288:2008)"
    accept "IEC/IEEE P63113 CD4, April 2019"
    accept "IEC/IEEE P60980-344 CDV D1, June 2019"
    accept "ISO/IEEE DIS P11073-10418 D13, January 2011"
# the two-party stage-less slot accepts the owner's draft face: the
# P-project rows are drafts and carry the word Draft in every face
# (the 2026-10-24 ruling), so the render must re-parse; the lettered
# IEC edition-draft designator (/ED<n>) rides the joint tails
accept "IEEE/IEC Draft P60079-30-1/D5, Jan, 2022"
accept "IEEE/IEC Draft P63195-2/ED4, Mar, 2021"
accept "IEEE/NACE Draft P2638/D2.4, Jan, 2020"
    accept "ISO/IEC/IEEE FDIS P15289_D3, 2017"
    # revision-notation + relaton-suffix dialects (no shim):
    # inline numbered REV, lettered REV strip, trailing REV after draft
    accept "IEEE Std P802.16_Rev2/D5"
    accept "IEEE Std P1310.Rev 3/D2"
    accept "IEEE P802.16Rev2/D9a"
    accept "IEEE P1722-rev1"
    accept "IEEE PC37.30.2/D043 Rev 18"
    accept "IEEE Std P802.16.2-REVa/D8"
    accept "IEEE Std P802.16/REVd/D5"
    # lettered REV is identity and keeps its printed separator; the bare
    # word with no id is the rev_bare marker (pubid ruling 2026-10-14)
    accept "IEEE P802.11-REVmc/D8.0, Aug 2016"
    accept "IEEE P802.15.3RevA-D00, January 2016"
    accept "IEEE P802.15.4REVi/D09, 04 2011"
    accept "IEEE Std 802.1AR-Rev/D2.2, September 2017"
    # hyphenated drafts with -YYYY[-MM] dates
    accept "IEEE P802.16/D-3-2017-07"
    accept "ANSI PC63.15/D-1.04-2017-06"
    accept "IEEE Approved Std P1516.4/D-x.1-2007-06"
    accept "IEEE P145/D-D2-2013"
    accept "IEEE/ISO/IEC P29119.2/D-IS-2011"
    accept "IEEE Unapproved Std P802.16_Rev2/D-3-2008-02"
    # revision-only and edition suffixes with dates
    accept "IEEE P1512.4/R-44-2006"
    accept "IEEE P802.15.4/D-09/R-i-2011-04"
    accept "ANSI/IEEE PC63.7/D-/R-17-2014"
    accept "IEC/IEEE P62209.3/E-2-2023-02"
    # draft + corrigendum compositions
    accept "IEEE Std P802.16-2004/D-5/Cor1-2005"
    accept "IEEE P11073.10419-2015/D-3/Cor1-2016"
    # main-body dialects (no shim): glued month-year, spaced dash-year,
    # bare P&V suffix
    accept "IEC/IEEE P60980-344 CDV D1, June2019"
    accept "IEEE P1722-rev1/D13, April2015"
    accept "IEEE P802.11ah/D7.0, March2016"
    accept "IEEE Std C37.102 -2006"
    accept "IEEE Std C62.35- 2010"
    accept "ANSI/IEEE Std 500-1984 P&V"
    # crawled "IEEE/ ASTM" spacing
    accept "IEEE/ ASTM SI 10-2010"
    accept "IEEE Std 100-2000"
    accept "IEEE P802.11"
    accept "ANSI/IEEE Std 91-1984"
    accept "IEEE/ASTM SI 10-2010"
    accept "IEEE Std 11073-10417-2009"
    accept "IEEE Std 1547-2018"
    accept "Std 11073-10417-2009"
    accept "Std 802.15.4j-2013"
    reject "nonsense"
  }
}
