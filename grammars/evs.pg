# Port of lib/pubid/evs/parser.rb: the EVS national-adoption wrapper
# around the CEN/CENELEC grammar — "EVS" ("-" | " ") <CEN identifier>.
# The CEN spine is IMPORTED via `use` (TODO 11/C6 imports): rules are
# namespaced cen_cenelec.* while captures keep their contract names.

use cen_cenelec

grammar PubidEvs version "0.2.0" {
  evs_separator = (dash / space) as evs_separator
  identifier = "EVS" evs_separator cen_cenelec.identifier

  dash = "-"
  space = " "

  entry identifier: identifier

  test {
    accept "EVS-EN 18216:2026"
    accept "EVS-EN ISO 9001:2015/A1:2024"
    accept "EVS EN 196-1:2016"
    reject "nonsense"
  }
}
