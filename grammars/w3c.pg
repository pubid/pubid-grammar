# Port of lib/pubid/w3c/parser.rb: split off the leading maturity token;
# code/date boundary is builder-side by design. Token order matters for
# shared prefixes (CRD before CR, PER before PR, DNOTE before NOTE).

grammar PubidW3c version "0.1.0" {
  any_char = %x01-10FFFF
  type_token = "DNOTE" / "NOTE" / "WD" / "CRD" / "CR" / "REC" / "PER" / "PR" / "SPSD" / "OBSL"
  type_part = type_token as type "-"
  rest = (1*any_char) as rest
  identifier = "W3C " [type_part] rest
  entry identifier: identifier

  test {
    accept "W3C REC-html40-19981224"
    accept "W3C NOTE-datetime-19980827"
    reject "nonsense"
  }
}
