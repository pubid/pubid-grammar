#!/usr/bin/env ruby
# frozen_string_literal: true

# The PFS compiler CLI.
#
#   ruby scripts/pfs compile DEFINITION.pfs --as FLAVOR_KEY [options]
#
# Compiles a .pfs definition to grammars/<key>.parg (PFS header marked),
# bakes artifacts/<key>.json through the pinned parsanol, verifies the
# definition's REQUIRED examples against the baked artifact, and
# optionally emits the Ruby flavor module (--ruby-out DIR).
#
# The engine pin is mandatory (the bake-one.rb rule: a binstub resolves
# the LATEST installed gem, so the compiler must be activated explicitly):
#   ruby scripts/pfs compile definitions/doi.pfs --as doi_pfs \
#     --parsanol-version 1.3.126

require "optparse"

options = {
  grammar_out: nil,
  artifact_out: nil,
  ruby_out: nil,
  parsanol_version: nil,
}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: ruby scripts/pfs compile DEFINITION.pfs --as KEY [options]"
  opts.on("--as KEY", "the compiled flavor key (e.g. doi_pfs)") { |v| options[:flavor_key] = v }
  opts.on("--grammar-out PATH") { |v| options[:grammar_out] = v }
  opts.on("--artifact-out PATH") { |v| options[:artifact_out] = v }
  opts.on("--ruby-out DIR", "emit the Ruby flavor module under DIR") { |v| options[:ruby_out] = v }
  opts.on("--parsanol-version V", "the pinned compiler version (mandatory)") do |v|
    options[:parsanol_version] = v
  end
end
parser.parse!

command = ARGV.shift
usage = ->(message) { abort "#{message}\n\n#{parser}" }

usage.call("command must be `compile`") unless command == "compile"
definition_path = ARGV.shift
usage.call("a definition file is required") unless definition_path
usage.call("--as KEY is required") unless options[:flavor_key]
usage.call("--parsanol-version V is required") unless options[:parsanol_version]

repo_root = File.expand_path("..", __dir__)
source_rel = definition_path
source_rel = source_rel.dup.force_encoding(Encoding::UTF_8)
if source_rel.start_with?(repo_root)
  source_rel = source_rel.delete_prefix("#{repo_root}/")
end

# Pin the engine BEFORE anything requires parsanol (bake-one.rb rule).
gem "parsanol", options[:parsanol_version]

$LOAD_PATH.unshift(File.join(repo_root, "lib"))
require "pubid/grammar/pfs"

result = Pubid::Grammar::Pfs::Compiler.compile(
  definition_path,
  source_rel: source_rel,
  flavor_key: options[:flavor_key],
  grammar_out: options[:grammar_out] || File.join(repo_root, "grammars", "#{options[:flavor_key]}.parg"),
  artifact_out: options[:artifact_out] || File.join(repo_root, "artifacts", "#{options[:flavor_key]}.json"),
  repo_root: repo_root,
  parsanol_version: options[:parsanol_version],
  ruby_out: options[:ruby_out],
)

puts "compiled #{definition_path} (pfs:#{Pubid::Grammar::Pfs::SCHEMA_VERSION}) " \
     "-> #{result.grammar_path}"
puts "baked -> #{result.artifact_path} " \
     "(checksum #{result.envelope["checksum"][0, 12]}..., " \
     "compiler #{result.envelope["compiler_version"]})"
puts "examples: #{result.definition.examples[:positives].size} positives, " \
     "#{result.definition.examples[:negatives].size} negatives — verified against the baked artifact"
unless result.ruby_files.empty?
  puts "ruby flavor -> #{result.ruby_files.size} files under #{options[:ruby_out]}"
end
