n \"1\" { k = 1*3(e / f) !(g h) }","expect":{}},{"entry":"file","kind":"reject","input":"nonsense","expect":{}},{"entry":"file","kind":"reject","input":"grammar T version \"1\" { = }","expect":{}}],"docs":{},"source":"# PG described in PG — the self-description grammar (F10, phase 1).\n# It recognizes the language this file is written in, over raw text:\n# whitespace is threaded explicitly (pq = potential whitespace within a\n# line, nlws = line-breaking whitespace). The reference compiler remains\n# parsanol-ruby (SSOT, TODO 11); this artifact is the validator.\n\ngrammar PgMeta version \"1.0.0\" {\n\n  # ---- lexical ----\n  digit = %x30-39\n  hexdig = %x30-39 / %x41-46 / %x61-66\n  letter = %x41-5A / %x61-7A\n  ident_char = letter / digit / %x5F\n  ident = 1*ident_char\n  newline = %x0A\n  nonl = %x01-09 / %x0B-10FFFF\n  comment = \"#\" *nonl\n  doc_marker = \"##\" *nonl\n  ws = %x20 / %x09\n  nlws = 1*(ws / newline)\n  pq = *ws\n\n  # ---- terminals ----\n  str_body_char = %x01-09 / %x0B-21 / %x23-10FFFF\n  dstring = \"\\\"\" *(\"\\\\\" nonl / str_body_char) \"\\\"\"\n  istring = \"%i\" dstring\n  sstring = \"%s\" dstring\n  hexdigits = 2*6hexdig\n  hexlit = \"%x\" hexdigits [(\"-\" hexdigits) / 1*(\".\" hexdigits)]\n  hex = hexlit / istring / sstring / dstring\n\n  # ---- expressions (pq-threaded) ----\n  choice = seq *(pq \"/\" pq seq)\n  seq = element *(pq element)\n  element = pq (rep_prefix pq [pred / postfixed] / pred / postfixed)\n  rep_prefix = num [\"*\" [num]] / \"*\" [num]\n  num = 1*digit\n  pred = (\"!\" / \"&\") postfixed\n  postfixed = primary [pq \"as\" pq ident]\n  table_alt = \"alt\" pq \"from_table\" pq dstring pq \"column\" pq dstring\n  primary = hex / \"(\" choice \")\" / \"[\" choice \"]\" / table_alt / ident\n\n  # ---- rules and sections ----\n  rule = ident pq \"=\" pq choice\n  entry_section = \"entry\" pq ident \":\" pq ident\n  path = ident *((\"[\" \"]\") / (\".\" ident))\n  cardinality = 1*(digit / \".\" / \"*\")\n  binding = ident pq \"->\" pq path [pq \"(\" ident [\",\" pq cardinality] \")\"] [pq \"preprocess\" \":\" pq ident]\n  bindings_section = \"bindings\" pq ident nlws \"{\" *nlws binding nlws \"}\"\n  step = \"table_lookup\" pq ident pq ident pq \"->\" pq ident\n  preprocess_section = \"preprocess\" pq ident nlws \"{\" *nlws step nlws \"}\"\n  test_line = (\"accept\" / \"reject\" / \"example\") pq dstring [pq \"{\" *nlws test_pair *nlws \"}\"]\n  test_pair = ident \":\" pq (dstring / num / (\"true\" / \"false\"))\n  test_section = \"test\" [pq ident] nlws \"{\" *nlws [test_line *(nlws test_line)] nlws \"}\"\n  rule_line = rule / entry_section / bindings_section / preprocess_section / test_section / doc_marker / comment\n  grammar_block = \"grammar\" pq ident pq \"version\" pq dstring pq \"{\" *(nlws rule_line) *nlws \"}\"\n  render_section = \"render\" pq ident nlws \"{\" *(nlws render_seg) nlws \"}\"\n  render_seg = (\"field\" pq ident) / (\"literal\" pq dstring) / (\"cond\" pq ident nlws \"{\" *(nlws render_seg) nlws \"}\")\n  derive_section = \"derive\" pq ident pq dstring\n  top = grammar_block / entry_section / bindings_section / preprocess_section / test_section / render_section / derive_section\n  use_line = \"use\" pq ident\n  top_item = use_line / doc_marker / comment / top\n\n  pg_file = pq *(top_item [nlws]) pq\n\n  entry file: pg_file\n\n  test {\n    accept \"grammar T version \\\"1\\\" { x = %x30-39 }\"\n    accept \"grammar T version \\\"1\\\" { a = b / c as d }\"\n    accept \"grammar T version \\\"1\\\" { g = [x] 3*y !z &w (p / q) }\"\n    accept \"grammar T version \\\"1\\\" { k = 1*3(e / f) !(g h) }\"\n    reject \"nonsense\"\n    reject \"grammar T version \\\"1\\\" { = }\"\n  }\n}\n","checksum":"sha256:85219d4ea4e20cbd4993154f655ebfa761bdb1be4c10159a7c1b8d7fc45c3494"}