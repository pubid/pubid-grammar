e publisher: branches 2 and 3 are order-dependent (shared first bytes; ordered choice is decisive)","rule date: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule adopted_org_prefix: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule fragment_identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule identifier: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"identifier","tests":[{"entry":"identifier","kind":"accept","input":"EN 18216:2026","expect":{}},{"entry":"identifier","kind":"accept","input":"EN ISO 9001:2015","expect":{}},{"entry":"identifier","kind":"accept","input":"CEN/CLC TR 17161:2019","expect":{}},{"entry":"identifier","kind":"accept","input":"EN 196-1:2016+A1","expect":{}},{"entry":"identifier","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Port of lib/pubid/cen_cenelec/parser.rb. Pre-parse normalization\n# (U+2011/AD dashes, comment stripping, CEN-CLC/GUIDE forms) stays\n# binder-side: the grammar sees normalized input.\n\ngrammar PubidCenCenelec version \"0.1.0\" {\n  digit = %x30-39\n  space = \" \"\n  dash = \"-\"\n  slash = \"/\"\n  plus = \"+\"\n  colon = \":\"\n  publisher = ((\"CWA\" / \"HD\" / \"ES\" / \"CR\" / \"ENV\") as publisher) / ((\"EN\" / \"CEN\") as publisher [slash \"CLC\" as copublisher]) / (\"CLC\" as publisher [slash \"CEN\" as copublisher])\n  stage_prefix = (\"FprEN\" / \"prEN\") as type_with_stage\n  type = (\"Guide\" / \"GUIDE\" / \"TR\" / \"TS\") as type\n  number = 1*digit as number\n  part = dash 1*(digit / dash) as part\n  parts = *part as parts\n  month_digits = (\"01\" / \"02\" / \"03\" / \"04\" / \"05\" / \"06\" / \"07\" / \"08\" / \"09\" / \"10\" / \"11\" / \"12\") as month\n  year = colon 4digit as year\n  year_with_month = colon 4digit as year dash month_digits\n  date = year_with_month / year\n  amendment = (plus as amd_sep_plus / slash as amd_sep_slash) \"A\" 1*digit as amd_number [(colon 4digit as amd_year)]\n  corrigendum = (plus as amd_sep_plus / slash as amd_sep_slash) \"AC\" [*digit as cor_number] [(year_with_month / (colon 4digit as year))]\n  supplement = (amendment / corrigendum) as supplement\n  supplements = *supplement as supplements\n  edition = space \"ED\" 1*digit as edition\n  adopted_org_prefix = \"ISO\" / \"IEC\" / \"CISPR\"\n  adopted_string = (adopted_org_prefix *(!supplement !edition any_noln_char)) as adopted_string\n  any_noln_char = %x01-09 / %x0B-FF\n  fragment_identifier = ((stage_prefix / publisher) space number parts space \"AMD\" 1*digit as amendment_number space \"FRAG\" 1*digit as fragment_number) / ((stage_prefix / publisher) space number parts [year] (plus / slash) \"A\" 1*digit as amendment_number [(colon 4digit as amendment_year)] space \"FRAG\" 1*digit as fragment_number)\n  identifier = fragment_identifier / ((stage_prefix / publisher) [(space adopted_string)] [(space type / slash type)] [(space number parts [year])] supplements [edition])\n\n  entry identifier: identifier\n\n  test {\n    accept \"EN 18216:2026\"\n    accept \"EN ISO 9001:2015\"\n    accept \"CEN/CLC TR 17161:2019\"\n    accept \"EN 196-1:2016+A1\"\n    reject \"nonsense\"\n  }\n}\n","checksum":"sha256:6a7ea44da999793dbd03add67c1413fe275cd114aedb7d95478ec5c4d8529c8c"}