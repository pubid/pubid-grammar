43,50]}}],"root":51},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"identifier","tests":[],"docs":{},"source":"# Port of lib/pubid/ecma/parser.rb: ECMA-NNN[-part], ECMA TR/NNN,\n# ECMA MEM/NNN, each with optional \" edX[.Y]\" and \" volN\". The TR/MEM\n# vs standard alternation relies on the disjoint first character after\n# the prefix (T/M are not digits), as in the source.\n\ngrammar PubidEcma version \"0.1.0\" {\n  tr = \" TR/\" 1*digit as tr_number\n  mem = \" MEM/\" 1*digit as mem_number\n  standard = (\"-\" / \" \") 1*digit as number [(\"-\" 1*digit as part)]\n  edition_number = 1*digit *(dot 1*digit)\n  edition = \" ed\" edition_number as edition\n  volume = \" vol\" 1*digit as volume\n  identifier = \"ECMA\" (tr / mem / standard) [edition] [volume]\n  digit = %x30-39\n  dot = \".\"\n  entry identifier: identifier\n}\n","checksum":"sha256:6e99196890644e353c9cff5b317eaa9576976d39ba7e9a2167d6fd32165e343f"}