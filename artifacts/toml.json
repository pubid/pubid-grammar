ntry":"main","kind":"accept","input":"key = \"value\"","expect":{}},{"entry":"main","kind":"accept","input":"lit = 'raw text'","expect":{}},{"entry":"main","kind":"accept","input":"flag = true","expect":{}},{"entry":"main","kind":"accept","input":"big = 1_000_000","expect":{}},{"entry":"main","kind":"accept","input":"hex = 0xFF","expect":{}},{"entry":"main","kind":"accept","input":"oct = 0o755","expect":{}},{"entry":"main","kind":"accept","input":"bin = 0b1010","expect":{}},{"entry":"main","kind":"accept","input":"f1 = 3.14","expect":{}},{"entry":"main","kind":"accept","input":"f2 = -2.5e10","expect":{}},{"entry":"main","kind":"accept","input":"f3 = inf","expect":{}},{"entry":"main","kind":"accept","input":"f4 = nan","expect":{}},{"entry":"main","kind":"accept","input":"dt = 1979-05-27T07:32:00Z","expect":{}},{"entry":"main","kind":"accept","input":"dt2 = 1979-05-27T00:32:00.999999-07:00","expect":{}},{"entry":"main","kind":"accept","input":"d = 1979-05-27","expect":{}},{"entry":"main","kind":"accept","input":"t = 07:32:00","expect":{}},{"entry":"main","kind":"accept","input":"[table]\nk = 1","expect":{}},{"entry":"main","kind":"accept","input":"[[items]]\nk = 1\n[[items]]\nk = 2","expect":{}},{"entry":"main","kind":"accept","input":"[a.b.c]\nk = 1","expect":{}},{"entry":"main","kind":"accept","input":"\"quoted key\" = 1","expect":{}},{"entry":"main","kind":"accept","input":"arr = [1, 2, 3]","expect":{}},{"entry":"main","kind":"accept","input":"arr = [\n  1, # one\n  2,\n]","expect":{}},{"entry":"main","kind":"accept","input":"inline = { a = 1, b = \"x\" }","expect":{}},{"entry":"main","kind":"accept","input":"ml = \"\"\"\nline one\nline two\n\"\"\"","expect":{}},{"entry":"main","kind":"accept","input":"ml = '''\nraw line\n'''","expect":{}},{"entry":"main","kind":"accept","input":"# a comment\nk = 1 # trailing","expect":{}},{"entry":"main","kind":"accept","input":"esc = \"a\\nb\"","expect":{}},{"entry":"main","kind":"reject","input":"k = ","expect":{}},{"entry":"main","kind":"reject","input":"= 1","expect":{}},{"entry":"main","kind":"reject","input":"k = 0x","expect":{}},{"entry":"main","kind":"accept","input":"k = [1, 2,]","expect":{}},{"entry":"main","kind":"reject","input":"k = { a = 1, }","expect":{}},{"entry":"main","kind":"reject","input":"[unclosed","expect":{}},{"entry":"main","kind":"reject","input":"k = \"unterminated","expect":{}},{"entry":"main","kind":"reject","input":"k = tru","expect":{}},{"entry":"main","kind":"reject","input":"[a]]","expect":{}},{"entry":"main","kind":"reject","input":"k = 1.2.3","expect":{}}],"docs":{"line_sep":"Structure: expression lines separated by newline/comment runs.","value":"Values.","string":"Strings. Multi-line forms open with two quotes; the content run\nexcludes the quote character (the documented restriction).","integer":"Numbers. Underscores allowed between digits in every base.","date_time":"Date-times (RFC 3339 shapes) and their local prefixes.","array":"Arrays: newlines, comments and trailing commas allowed.","inline_table":"Inline tables: single-line, no trailing comma."},"source":"# TOML (subset): the configuration-language flavor of the rs#531\n# breadth program — after json/csv/ini/lua, the deepest data-format\n# grammar: table headers, dotted keys, five value kinds with their\n# numeric bases, four string forms, arrays with embedded comments and\n# newlines, inline tables.\n#\n# Subset (acceptance-complete for the shapes it declares):\n# bare/quoted/dotted keys, [table] and [[array-of-tables]] headers,\n# key = value pairs; basic strings (\"...\" with escapes), multi-line\n# basic strings (\"\"\"...\"\"\"), literal strings ('...'), multi-line\n# literal strings ('''...'''); integers (decimal with underscores,\n# 0x/0o/0b, signed), floats (fraction/exponent, inf, nan), booleans;\n# offset and local date-times, local dates and times (RFC 3339\n# shapes); arrays with newlines, comments and trailing commas;\n# inline tables. # comments.\n#\n# Two documented restrictions (UNDER-acceptance, safe for the gate):\n# multi-line strings may not contain their quote character (TOML\n# allows one or two); UTF-16 surrogate escapes \\uD... are accepted as\n# escape sequences but not combined.\n\ngrammar Toml version \"1.0.0\" edition 2 {\n  ws = *( %x20 / %x09 )\n  nl = %x0A / %x0D\n  aw = *( %x20 / %x09 / %x0A / %x0D / comment )\n  comment = ( \"#\" *( %x09 / %x20-10FFFF ) [ nl ] ) as comment\n\n  ## Structure: expression lines separated by newline/comment runs.\n  line_sep = 1*( %x20 / %x09 / %x0A / %x0D / comment )\n  toml = *( line_sep ) [ expr_line *( line_sep expr_line ) ] *1( line_sep )\n  expr_line = ( table_header / keyval ) as expr_line\n\n  keyval = ( key ws \"=\" ws value ) as keyval\n  table_header = ( \"[[\" ws key ws \"]]\" / \"[\" ws key ws \"]\" ) as table_header\n  key = ( simple_key *( ws \".\" ws simple_key ) ) as key\n  simple_key = ( bare_key / basic_string / literal_string ) as simple_key\n  bare_key = ( 1*( %x41-5A / %x61-7A / %x30-39 / %x5F / %x2D ) ) as bare_key\n\n  ## Values.\n  value = ( string / bool / date_time / array / inline_table / float / integer ) as value\n  bool = ( %i\"true\" / %i\"false\" ) as bool\n\n  ## Strings. Multi-line forms open with two quotes; the content run\n  ## excludes the quote character (the documented restriction).\n  string = ( ml_basic_string / ml_literal_string / basic_string / literal_string ) as string\n  basic_string = ( %x22 *( \"\\\\\" ( %x00-10FFFF ) / %x20-21 / %x23-5B / %x5D-10FFFF ) %x22 ) as basic_string\n  literal_string = ( %x27 *( %x20-26 / %x28-10FFFF ) %x27 ) as literal_string\n  ml_basic_string = ( %x22 %x22 %x22 *( %x00-21 / %x23-10FFFF ) %x22 %x22 %x22 ) as ml_basic_string\n  ml_literal_string = ( %x27 %x27 %x27 *( %x00-26 / %x28-10FFFF ) %x27 %x27 %x27 ) as ml_literal_string\n\n  ## Numbers. Underscores allowed between digits in every base.\n  integer = ( [ %x2B / %x2D ] ( %x30 ( %x78 / %x58 ) hexnum / %x30 ( %x6F / %x4F ) octnum / %x30 ( %x62 / %x42 ) binnum / decnum ) ) as integer\n  hexnum = hexdig *( [ %x5F ] hexdig )\n  octnum = %x30-37 *( [ %x5F ] %x30-37 )\n  binnum = %x30-31 *( [ %x5F ] %x30-31 )\n  decnum = digit *( [ %x5F ] digit )\n  float = ( [ %x2B / %x2D ] ( decfloat / %i\"inf\" / %i\"nan\" ) ) as float\n  decfloat = ( decnum \".\" 1*digit [ ( %x65 / %x45 ) [ %x2B / %x2D ] decnum ] / decnum ( %x65 / %x45 ) [ %x2B / %x2D ] decnum ) as decfloat\n\n  ## Date-times (RFC 3339 shapes) and their local prefixes.\n  date_time = ( full_date %x54 full_time / full_date %x20 full_time / full_date / full_time ) as date_time\n  full_date = ( 4*digit %x2D 2*digit %x2D 2*digit ) as full_date\n  full_time = ( 2*digit %x3A 2*digit %x3A 2*digit [ \".\" 1*digit ] [ ( %x5A / ( %x2B / %x2D ) 2*digit %x3A 2*digit ) ] ) as full_time\n\n  ## Arrays: newlines, comments and trailing commas allowed.\n  array = ( \"[\" aw [ value aw *( \",\" aw value aw ) [ \",\" aw ] ] \"]\" ) as array\n\n  ## Inline tables: single-line, no trailing comma.\n  inline_table = ( \"{\" ws [ keyval ws *( \",\" ws keyval ws ) ] \"}\" ) as inline_table\n\n  digit = %x30-39\n  hexdig = %x30-39 / %x41-46 / %x61-66\n\n  entry main: toml\n\n  test {\n    accept \"k = 1\"\n    accept \"key = \\\"value\\\"\"\n    accept \"lit = 'raw text'\"\n    accept \"flag = true\"\n    accept \"big = 1_000_000\"\n    accept \"hex = 0xFF\"\n    accept \"oct = 0o755\"\n    accept \"bin = 0b1010\"\n    accept \"f1 = 3.14\"\n    accept \"f2 = -2.5e10\"\n    accept \"f3 = inf\"\n    accept \"f4 = nan\"\n    accept \"dt = 1979-05-27T07:32:00Z\"\n    accept \"dt2 = 1979-05-27T00:32:00.999999-07:00\"\n    accept \"d = 1979-05-27\"\n    accept \"t = 07:32:00\"\n    accept \"[table]\nk = 1\"\n    accept \"[[items]]\nk = 1\n[[items]]\nk = 2\"\n    accept \"[a.b.c]\nk = 1\"\n    accept \"\\\"quoted key\\\" = 1\"\n    accept \"arr = [1, 2, 3]\"\n    accept \"arr = [\n  1, # one\n  2,\n]\"\n    accept \"inline = { a = 1, b = \\\"x\\\" }\"\n    accept \"ml = \\\"\\\"\\\"\nline one\nline two\n\\\"\\\"\\\"\"\n    accept \"ml = '''\nraw line\n'''\"\n    accept \"# a comment\nk = 1 # trailing\"\n    accept \"esc = \\\"a\\\\nb\\\"\"\n    reject \"k = \"\n    reject \"= 1\"\n    reject \"k = 0x\"\n    accept \"k = [1, 2,]\"\n    reject \"k = { a = 1, }\"\n    reject \"[unclosed\"\n    reject \"k = \\\"unterminated\"\n    reject \"k = tru\"\n    reject \"[a]]\"\n    reject \"k = 1.2.3\"\n  }\n\n\n\n\n}\n","source_hash":"469dcbad6193660910963eef44857e7c206080eea83ad649e2cd436ea134791e","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.5.1.0","edition":2,"semantics_hash":"sha256:e9a24feb2a44ae8198a987ceaba28c35f71228d94a588bccce886119fbf04555","checksum":"sha256:bafa48788da62009b030ab168a27082cd684f766cf15365075fce7578d42e9e3","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":37,"tests_failures":0,"self_test":true}}