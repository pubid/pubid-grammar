 as main dot 1*digit as sub)\n  complex_number = (1*alnum_char as prefix1 [(dash 1*alnum_char as prefix2)] space 1*digit as num)\n  simple_number = 1*digit as num\n  number = (gsm_with_space_number / dotted_number / complex_number / simple_number) as number\n  minor = space 1*digit as minor\n  part = dash 1*alnum_char as part\n  parts = *part as parts\n  version = \"V\" 1*version_char as version\n  edition = \"ed.\" 1*digit as edition\n  version_or_edition = version / edition\n  date_part = \"(\" 4digit as year dash 2digit as month \")\"\n  single_supplement = ((\"/A\" 1*digit) as amendment / (\"/C\" 1*digit) as corrigendum)\n  supplements = 1*single_supplement as supplements\n  identifier = \"ETSI \" type space number [minor] [parts] [supplements] [(space version_or_edition)] [(space date_part)]\n  alnum_char = %x41-5A / %x61-7A / %x30-39\n  version_char = %x30-39 / %x2E\n  digit = %x30-39\n  dash = \"-\"\n  dot = \".\"\n  space = \" \"\n  entry identifier: identifier\n\n  test {\n    accept \"ETSI EN 300 175\"\n    accept \"ETSI TR 101 999\"\n    reject \"nonsense\"\n  }\n}\n","checksum":"sha256:eaaff074002a1b46886d87665ff03e349d2d5afcbe882c27bf1b74a43e16be49"}